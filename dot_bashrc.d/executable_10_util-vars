#!/usr/bin/env bash
# shellcheck disable=SC2034 # allow unused variables

# ~/.bashrc.d/10_utilVars.sh
#
# Stores variables useful to end-user usage
# Includes token keys and common directory variables
# Any variable declared here is exported automatically
OLDOPTS=$(set +o)
set -o allexport
# Make sure code goes below this

# Release-it Github Key
RELEASE_IT_GITHUB_TOKEN='***REMOVED***'

# File locations
vscode=~/vscode
bash=$vscode/bashScripts
js=$vscode/js
javascript=$js
java=$vscode/Java
python=$vscode/Python
chromeext=$vscode/chromeExtensions
config=$vscode/config
backup=/mnt/chromeos/removable/Backup/

# Place Variables above this
while IFS= read -r line; do
    eval "$line"
done < <(printf '%s' "$OLDOPTS")
unset OLDOPTS
