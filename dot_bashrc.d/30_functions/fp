#!/usr/bin/env bash

# ~/.bashrc.d/20_alias
#
# Sets up fp function for fuzzy finding.
# Also sets default fzf command for direct invocations
#

if command -v fzf &>/dev/null; then
  FZF_BASE_COMMAND='fd  --color=always --follow --hidden --exclude .git'
  export FZF_DEFAULT_COMMAND="$FZF_BASE_COMMAND --type file"
  # ALlow color
  export FZF_DEFAULT_OPTS="--ansi"

  fp() {
    if [ "$1" = '--help' ]; then
      printf '%s\n%s' \
        'fp' \
        '' \
        'Uses find with the first argument to output the user'"'"'s choice of files' \
        "Commonly used as vim \"\$(fp)\""
      return 0
    fi
    fzf_preview () {
      local json BAT_CMD
      BAT_CMD="bat --style=numbers --color=always --line-range :500"

      printf '%s\n' PREVIEW
      if json=$(fx "$1");then
        printf '%s\n\n' FX
        printf '%s' "$json" | $BAT_CMD
      else
        printf '%s\n\n' BAT
        $BAT_CMD "$1"
      fi
    }
    export -f fzf_preview

    # Call with the path given, if applicable, and find all files
    FZF_DEFAULT_COMMAND="$FZF_DEFAULT_COMMAND . \"${1:-.}\"" fzf --preview "fzf_preview {}" #"bat --style=numbers --color=always --line-range :500 {}"
  }
  #
  # For finding directories
  fpd() {
    if [ "$1" = '--help' ]; then
        printf '%s\n%s' \
            'fp' \
            '' \
            'Uses find with the first argument to output the user'"'"'s choice of folders' \
            "Commonly used as cd \"\$(fp)\""
        return 0
      fi
      # Call with the path given, if applicable, and find all directories
      FZF_DEFAULT_COMMAND="$FZF_BASE_COMMAND --type d . \"${1:-.}\"" fzf
  }
fi
