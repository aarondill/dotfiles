#!/usr/bin/env bash

# ~/.bashrc.d/20_alias
#
# Sets up fp function for fuzzy finding files, and
# fpd function to fuzzy find directories. Each command displays a
# preview through bat/cat and tree/ls respectively.
#
# Also sets default fzf command for direct invocations
#
# By default is colorized, but can be disabled by unsetting FZF_USE_COLOR
#

# only do these if fzf exists
if ! command -v fzf &>/dev/null; then
  return
fi
export FZF_USE_COLOR=true

# Use better find if installed
if command -v fd &>/dev/null; then
  # Echo if FZF_USE_COLOR is set
  export FZF_BASE_COMMAND='fd "$(test "$FZF_USE_COLOR" && echo --color=always)" --follow --hidden --exclude .git'
  export FZF_FIND_DIR="$FZF_BASE_COMMAND --type d . {}"
  export FZF_FIND_FILE="$FZF_BASE_COMMAND --type f . {}"
else
  export FZF_BASE_COMMAND='find'
  export FZF_FIND_DIR="$FZF_BASE_COMMAND {} --type d"
  export FZF_FIND_FILE="$FZF_BASE_COMMAND {} --type f"
fi

# Use better cat if installed
if command -v bat &>/dev/null; then
  export FZF_BAT_CMD="bat --style=numbers --color=always"
  export FZF_BAT_CMD_JSON="$FZF_BAT_CMD --language JSON"
else
  export FZF_BAT_CMD="cat"
  export FZF_BAT_CMD_JSON="$FZF_BAT_CMD"
fi

if command -v tree &>/dev/null; then
  export FZF_DIR_PREVIEW='tree -C {}'
else
  export FZF_DIR_PREVIEW='ls {}'
fi
FZF_FILE_PREVIEW () {
  local json
  # Attempt to prettify json before display
  # will return false if prettier isn't installed
  if json=$(cat "$1" | prettier --parser json5 2>/dev/null); then
    # Shows first 500 lines
    printf '%s' "$json" | $FZF_BAT_CMD_JSON
  else $FZF_BAT_CMD "$1"
  fi
}
export -f FZF_FILE_PREVIEW

export FZF_DEFAULT_COMMAND="${FZF_FIND_FILE//\{\}/.}"
export FZF_DEFAULT_OPTS="--ansi"

fp() {
  if [ "$1" = '--help' ]; then
    printf '%s\n%s'
    \  'fp'
    \  ''
    \  'Uses find with the first argument to output the user'"'"'s choice of files'
    \  'Opens editor if stdout is connected to a tty'
    return 0
  fi
  local output path
  path=${1:-.}
  # Call with the path given, if applicable, and find all files
  output=$(
    FZF_DEFAULT_COMMAND="${FZF_FIND_FILE//\{\}/$path}" fzf --preview "FZF_FILE_PREVIEW {} | head -n500" "${@:2}"
  )
  if [[ -t 1 ]]; then
    editor "$output"
  else 
    printf '%s' "$output"
  fi
}

# For finding directories
fpd() {
  if [ "$1" = '--help' ]; then
    printf '%s\n%s'
    \  'fp'
    \  ''
    \  'Uses find with the first argument to output the user'"'"'s choice of folders'
    \  'calls cd if stdout is connected to a tty'
    return 0
  fi
  local output path
  path=${1:-.}
  # Call with the path given, if applicable, and find all directories
  output=$(
  FZF_DEFAULT_COMMAND="${FZF_FIND_DIR//\{\}/$path}" fzf --preview "$FZF_DIR_PREVIEW | head -n200" "${@:2}"
  )
  if [[ -t 1 ]]; then
    cd "$output"
  else 
    printf '%s' "$output"
  fi
}
