# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>

# / is on /dev/nvme0n1p4 
UUID=bfd2bd16-5af1-48b2-a0ed-064bf313e621 /               ext4    errors=remount-ro 0       1

# /home is on /dev/nvme0n1p7 
UUID=f763d1c6-8afd-4a9f-8429-cff15369fda6 /home               ext4    errors=remount-ro 0       1


# /boot/efi is on /dev/nvme0n1p 
UUID=6416-06C3  /boot/efi       vfat    umask=0077      0       1

# Swap space is on /dev/nvme0n1p6
UUID=251a8ad6-5c96-4fbe-b2b0-52ca549f45a8 none swap defaults 0 0

