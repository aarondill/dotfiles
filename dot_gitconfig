# ~/.gitconfig
[user]
	name = aarondill
	email = aaronsacks2006@gmail.com
[core]
	editor = vim
[push]
	default = current
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[pull]
	rebase = false
[format]
        pretty =format:"%C(yellow)commit %H%C(auto)%d%n%C(reset)%C(brightblue)Author: %an <%ae>%C(reset)%n%C(green)Date:   %ad%C(reset)%n%n%C(brightyellow)%w(0,4,4)%s%n%n%C(reset)%b%n" 
[alias]
	last = log -1 HEAD
	unstage = reset HEAD --
	commit = commit -v
	alias = "!_no_user_made_f(){ if [ \"$1\" = \"--unset\" ]; then git config --global --unset \"alias.$2\" ;else local a=$1; shift ; git config --global \"alias.$a\" \"$@\" ; fi ; unset _no_user_made_f ; } ; _no_user_made_f"
	ci = commit
	st = status
	br = branch
	fpush = push --force-with-lease
	pushf = push --force-with-lease
	branches = branch
	amend = commit --amend
	hist = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
