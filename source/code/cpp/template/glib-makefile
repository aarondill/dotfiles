# Make file for the ./file.c program
# Using GLib

CC = gcc
CFLAGS = -Wall -g $(shell pkg-config --cflags glib-2.0)
LDFLAGS = -lm $(shell pkg-config --libs glib-2.0)
BIN = file
SRC = file.c
OBJ = $(SRC:.c=.o)

# The rule to make the executable file
all: $(BIN)
clean:
	rm -f $(OBJ) $(BIN)
	
# The rule to make the object files
$(OBJ): $(SRC)
	$(CC) $(CFLAGS) -c $< -o $@
