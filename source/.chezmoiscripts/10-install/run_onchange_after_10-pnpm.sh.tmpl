# package.json hash: {{ include ( first $files_arr ) | sha256sum }}

# Source utils
SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-"$(chezmoi source-path)"}"
# shellcheck source=../.utils.sh
. "$SOURCE_DIR/.chezmoiscripts/.utils.sh"

function add_global_dir_to_path() {
  local global_bin_dir
  global_bin_dir="$(pnpm config get global-bin-dir 2>/dev/null || printf '')"
  if [ -z "$global_bin_dir" ]; then return 1; fi
  case ":$PATH:" in
  *:"$global_bin_dir":*) return 0 ;;
  *) PATH="$PATH:$global_bin_dir" ;;
  esac
}

URL=https://raw.githubusercontent.com/tj/n/master/bin/n
function install_pnpm_and_node() {
  local tmp
  log 'installing n'
  tmp=$(download_file "$URL")
  rm_exit "$tmp"
  log 'installing node lts through n...'
  (
    export -n SHELLOPTS
    # NOTE: latest is needed on my machine to avoid EHOSTUNREACH from npm repos
    sudo bash "$tmp" latest
  )
  rm_exit_cleanup "$tmp"

  # Setup pnpm
  log 'installing pnpm'
  corepack enable
  corepack prepare pnpm@latest --activate >/dev/null

  add_global_dir_to_path || [ -n "$PNPM_HOME" ]

  log 'installing n through pnpm'
  # requires wget
  pnpm i -g n
}

install_pnpm_global_packages() {
  add_global_dir_to_path || [ -n "$PNPM_HOME" ]
  pnpm i -g n
}

