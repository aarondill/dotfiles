#!/usr/bin/env bash
set -euC -o pipefail

# Source utils
SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-"$(chezmoi source-path)"}"
# shellcheck source=../.utils.sh
. "$SOURCE_DIR/.chezmoiscripts/.utils.sh"

# crontab hash: {{ include "private_dot_config/crontab" | sha256sum }}
if ! command -v crontab &>/dev/null; then
  abort 'crontab is not installed. Please install crontab to use this backup' 0
fi

read -rep "load crontab from source? (yes) " confirmation </dev/tty
if [[ -z "$confirmation" || "${confirmation,,}" =~ ^\s*y(es)?\s*$ ]]; then
  printf '%s\n' 'Updating crontab'
  file=
  # find the crontab file
  for f in "$SOURCE_DIR/"*"_dot_config/crontab"; do
    [ -f "$f" ] || continue
    file="$f" && break
  done
  crontab "$file"
fi

# Set the filetype in vim to sh: vim:ft=sh:
