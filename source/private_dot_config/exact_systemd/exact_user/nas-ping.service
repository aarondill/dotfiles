[Unit]
Description=Ping NAS
After=NetworkManager-wait-online.service

[Service]
Environment=NAS_HOST=pihole POLL_INTERVAL=30
Type=oneshot
# Intentionally not RemainAfterExit=yes so that it runs each time (since it may later become inaccessible)
ExecStartPre=echo "Waiting for NAS..."
ExecStart=bash -c 'while ! ping -c1 "$NAS_HOST" &>/dev/null; do sleep "$POLL_INTERVAL"; done'
ExecStartPost=echo "NAS is accessible!"

[Install]
WantedBy=default.target
