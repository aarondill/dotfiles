# vim: set ft=systemd:
[Unit]
Description=File Backups
After=ping@%i.service
Requires=ping@%i.service

[Service]
Type=oneshot
# Note: doesn't use %i. Make sure the backup script is setup right, or change this and pass in the hostname.
ExecStart=%h/.local/bin/backup
# Don't verify backups, makes it much faster.
Environment="BACKUP_VERIFY=0"
Environment="BACKUP_VERBOSE=1"
