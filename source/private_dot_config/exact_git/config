# ~/.config/git/config
[user]
  name = aarondill
  email = aaronsacks2006@gmail.com
[credential "https://github.com"]
  helper = 
  helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper = 
  helper = !/usr/bin/gh auth git-credential
[core]
	editor = nvim
  excludesFile = ~/.config/git/ignore
# DELTA SETUP
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    line-numbers = true
    pager = less -RF
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
# END DELTA SETUP
[init]
  defaultBranch = main # not master
  # Disable the templatedir to save storage (this is copied into *every* .git directory)
	templatedir = 
[fetch]
  prune = true
[push]
  default = current
[pull]
  ff = yes
  rebase = merges
[merge]
  ff = no
[rebase]
  autosquash = true
[rerere]
  enabled = true

[format]
  pretty = format:"%C(yellow)commit %H%C(auto)%d%n%C(reset)%C(brightblue)Author: %an <%ae>%C(reset)%n%C(green)Date:   %ad%C(reset)%n%n%C(brightyellow)%w(0,4,4)%s%n%n%C(reset)%b%n" 
[color]
  ui = auto
[color "branch"]
  remote = brightgreen
  local = brightblue
  current = brightcyan bold
  upstream = yellow

[alias]
  alias-wrapper = "!~/.config/git/alias-wrapper.sh"
  # Create new aliases with git alias 'name' 'cmd'
  alias = "alias-wrapper alias"
  unalias = "alias-wrapper unalias"
  # Last commit
  last = log -1 HEAD

  # Remove from staging area
  unstage = reset HEAD --

  # Verbose committing
  commit = commit -v

  # Abbreviations
  sw = switch
  res = restore
  ci = commit
  co = commit
  st = status
  br = branch
  p = !git push origin \"$(git rev-parse --abbrev-ref HEAD)\" -u
  new = switch -c

  # Less destructive pushing
  pushf = push --force-with-lease
  fpush = pushf
  pf = pushf

  # Fix my typos
  branches = branch
  amend = commit --amend
  ammend = amend

  # Pretty log
  hist = log --graph '--pretty=format:%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  history = hist
  yesterday = alias-wrapper yesterday
  diff-origin = alias-wrapper diff-origin

  # Things I forget
  rmremotebranch = push --delete 
  mvbranch = alias-wrapper mvbranch

  # Show branches
  local-branches = "!git branch --format \"%(color:red)%(HEAD) \
    %(color:brightblue)%(refname:short)%(color:reset)\
    %(if) %(upstream) %(then) --> %(color:brightgreen)%(upstream:short) \
    u%(upstream:trackshort)%(end)\
    %(if) %(symref) %(then): %(symref:short)%(end)\"" 
  remote-branches = branch -r
  all-branches = !git remote-branches && git local-branches

  # Random Utilities
  root = rev-parse --show-toplevel
  # Get to a detached HEAD state on purpose! Usage: `git detach [REF]`
  detach = switch -d
  # Print short sha1; usage: `git sha1 [REF]`
  sha1 = alias-wrapper sha1
  # Commit a fixup
  added-in = log --follow --diff-filter=A --find-renames=40% --
  fixup = commit --fixup
  merge-remote = "!git fetch --all && git merge"
  shallowify = alias-wrapper shallowify
  blobless = clone --filter=blob:none
  treeless = clone --filter=tree:0
  rh = reset --hard
  hdiff = alias-wrapper hdiff
	cleanup = alias-wrapper cleanup
	rg = grep
	sync-tags = alias-wrapper sync-tags
	get-remote = alias-wrapper get-remote
[branch]
	sort = -committerdate
[maintenance]
	repo = /home/aaron/code/js/fslite
	repo = /home/aaron/.config/nvim.bak
	repo = /home/aaron/.config/awesome
