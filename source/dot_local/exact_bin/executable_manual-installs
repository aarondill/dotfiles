#!/usr/bin/env bash
set -euC -o pipefail && shopt -s nullglob globstar
utils=script_utils.sh dir=$(dirname -- "${BASH_SOURCE[0]}") || true
if [ -f "$dir/$utils" ]; then utils="$dir/$utils"; fi
# shellcheck source=./script_utils.sh
. "$utils" || exit

has_cmd dpkg || abort "dpkg not found! Is this a debian-based distribution?" 2

release=$(. /etc/os-release && printf '%s' "$VERSION" | awk '{print $1}')
codename=$(. /etc/os-release && printf '%s' "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
desktop=$(dpkg -l ubuntu-desktop &>/dev/null && printf "desktop" || printf "live-server")
manifestURL="http://releases.ubuntu.com/$codename/ubuntu-$release-$desktop-amd64.manifest"
backupURL="http://releases.ubuntu.com/jammy/ubuntu-22.04.2-desktop-amd64.manifest"

function usage() {
  cat <<EOF || true
Usage: $THIS [options]
uses apt-mark to fetch a list of manually installed packages and compares against the
ubuntu manifest (or a given list of packages) to find the packages that were manually
installed by the user.

Options:
  -h, --help           show this message
  -m, --manifest=url   use the url given to download the manifest (default: $manifestURL)
EOF
}
LONGOPTS=help,manifest: SHORTOPTS=h,m:
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit

while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  -m | --manifest) manifestURL="$2" && shift 2 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done
[ -n "$manifestURL" ] || abort "No manifest URL was provided" 2
check_dependencies apt-mark curl dpkg || exit

showmanual=$(apt-mark showmanual | sort)

manifest_content=
for url in "$manifestURL" "$backupURL"; do
  manifest_content=$(curl -SsLf -- "$url" | cut -f1 | sort) || true
  [ -z "$manifest_content" ] || break # we got something, stop trying
  err "downloading the manifest from '$manifestURL' failed!"
done
[ -n "$manifest_content" ] || abort "downloading the manifest failed. Aborting." 1

comm -23 <(printf "%s" "$showmanual") <(printf "%s" "$manifest_content")
