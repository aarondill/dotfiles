#!/usr/bin/env sh

CHROME=
if [ -x "$(command -v google-chrome-stable)" ]; then
  CHROME="$(command -v google-chrome-stable)"
elif [ -x "$(command -v google-chrome)" ]; then
  CHROME="$(command -v google-chrome)"
fi

if [ -z "$CHROME" ]; then
  printf '%s\n' 'google-chrome-stable: command not found' >&2
  exit 127
fi

exec "$CHROME" --enable-features=WebUIDarkMode --force-dark-mode 2>/dev/null
