#!/usr/bin/env bash
# usage: fullscreen [Search-Term]
set -euC -o pipefail
THIS=fullscreen
log() { printf '%s\n' "$@"; }
err() { printf "$THIS: %s\n" "$@" >&2; }
abort() { err "$1" && exit "${2:-1}"; }
usage() {
  command cat <<EOF
$THIS [options...] [--] [SEARCH] [xdotool-args...]

if run without arguments, uses selectwindow to request a window,
else searches window class, name, and classname for SEARCH. When
A window is found, it is maximized and moved to the top left corner.
Use DISPLAY=:dsp fullscreen to control other screens

xdotool-args are commands for xdotool that are prepended to the
windowsize command. Use {id} to mean the specified window id.

Options:
-h, --help              Show this help message
-d, --display=display   Set the display to use (default $DISPLAY)
EOF
  return 0
}

# Returns a string that should be 'eval'ed to set the positional arguments
# Store the string in a variable (ie ARGSTRING) to maintain the exit code if parse_args fails.
# Input: $LONGOPTS,$SHORTOPTS
# eval "$(parse_args "$@")"
function parse_args() {
  # -allow a command to fail with !’s side effect on errexit
  # -use return value from ${PIPESTATUS[0]}, because ! hosed $?
  # shellcheck disable=SC2251
  ! getopt --test >/dev/null
  if [[ "${PIPESTATUS[0]}" -ne 4 ]]; then abort "Enhanced getopt is required for this script to work. Please install it." 1; fi

  local parsed
  if parsed=$(getopt --options="$SHORTOPTS" --longoptions="$LONGOPTS" --name "${THIS:-$0}" -- "$@"); then
    # output getopt’s output this way to handle the quoting right:
    printf '%s' "set -- $parsed"
    return 0
  fi
  # getopt has already complained about wrong arguments to stdout - Exit script
  exit 2
}

# option --long/-l requires 1 argument
LONGOPTS=help,display: SHORTOPTS=h,d:
ARGSTRING="$(parse_args "$@")"
eval "$ARGSTRING"

display="${DISPLAY:-}"
while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  -d | --display) display="$2" && shift 2 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

classname="${1:-}"
if [ -z "$classname" ]; then
  find=(selectwindow)
else
  find=(search --name --class --classname -- "$classname")
fi
id=$(DISPLAY="$display" xdotool "${find[@]}") || abort "Could not find window on display: '${display:-NONE}'"

userargs=()
# Replace {id} with the id in the user string
for arg in "${@:2}"; do userargs+=("${arg//\{id\}/$id}"); done

DISPLAY="$display" xdotool "${userargs[@]}" windowsize "$id" 100% 100% windowmove "$id" 0 0
