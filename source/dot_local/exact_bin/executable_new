#!/usr/bin/env bash
function err() { printf '%s\n' "$@" >&2; }
function log() { printf '%s\n' "$@"; }
function abort() {
  err "$1"
  exit "${2:-1}"
}
function has() {
  local c && for c in "$@"; do
    command -v -- "$c" &>/dev/null || return
  done
}

lang="${1:-}"
dest="${2:-new}"
if [ -z "$lang" ]; then
  abort "usage: new <lang> [dest]" 2
fi
shift                             # remove lang from arguments
if [ "$#" -gt 0 ]; then shift; fi # remove dest from arguments
if has "new-$lang"; then
  exec -- "new-$lang" "$dest" "$@"
fi

template_dir="$HOME/code/$lang/template"
if ! [ -d "$template_dir" ]; then
  abort "Could not find $template_dir" 1
fi

# Copy the template directory
cp -ri "$template_dir" "$dest"

date=$(date '+%m/%d/%Y')
time=$(date '+%H:%M')

# usage: substitute file <file >file.new && mv file.new file
function substitute() {
  local path="$1" fp rp bn dn
  if [ -z "$path" ]; then abort "substitute requires a filepath!" 2; fi
  fp=$(realpath --relative-to="$dest" -s -- "$path") # filepath relative to root
  rp=$(realpath -s -- "$path")                       # full realpath
  bn=$(basename -- "$path")                          # basename of file
  dn=$(dirname -- "$fp")                             # dirname relative to root

  sed \
    -e "s:\${DATE}:${date//:/\\:}:g" \
    -e "s:\${TIME}:${time//:/\\:}:g" \
    -e "s:\${FILENAME}:${bn//:/\\:}:" \
    -e "s:\${FILEPATH}:${fp//:/\\:}:" \
    -e "s:\${DIRNAME}:${dn//:/\\:}:" \
    -e "s:\${REALPATH}:${rp//:/\\:}:"
}

for f in "$dest"/**; do # handle filename replacements
  filename=$(basename -- "$f")
  newname=$(printf '%s' "$filename" | substitute "$f")
  if [ "$filename" != "$newname" ]; then
    mv "$f" "$(dirname -- "$f")/$newname" # move to new location
  fi
done

function _cleanup() { [ -n "$tmp" ] && rm -rf "$tmp" && trap '' EXIT; }
tmp="$(mktemp)" && trap _cleanup EXIT
for f in "$dest"/**; do               # handle string replacements
  if ! [ -f "$f" ]; then continue; fi # ignore directories
  # shellcheck disable=SC2094 # substitute doesn't output to a file
  substitute "$f" <"$f" >"$tmp" # Write to tmp file to avoid loosing data (https://www.shellcheck.net/wiki/SC2094)
  mv -f -- "$tmp" "$f"          # overwrite existing file
done
_cleanup
