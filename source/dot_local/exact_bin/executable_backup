#!/usr/bin/env bash
set -euC -o pipefail && shopt -s nullglob globstar
utils=script_utils.sh dir=$(dirname -- "${BASH_SOURCE[0]}") || true
if [ -f "$dir/$utils" ]; then utils="$dir/$utils"; fi
# shellcheck source=./script_utils.sh
. "$utils"

if [ "${BACKUP_SKIP_INHIBIT:-}" != 1 ]; then
  export BACKUP_SKIP_INHIBIT=1 # avoid infinite recursion
  exec systemd-inhibit \
    --what=shutdown \
    --who="$THIS" \
    --why="To run the system backup" \
    --mode=block \
    "${BASH_SOURCE[0]}" "$@"
fi

# Calls duplicity to run a backup. Passes user arguments to first arguments of duplicity.
# Requires duplicity to be installed

# ----------------------------------------------------------------
# ----------------------------------------------------------------
# ------------------------ CONFIGURATION -------------------------
# ----------------------------------------------------------------
# ----------------------------------------------------------------

# Set the symbolic name of the backup being operated on. The intent is to use a separate name for each logically distinct backup. For example, someone
# may use "home_daily_s3" for the daily backup of a home directory to Amazon S3. The structure of the name is up to the user, it is only important that
# the names be distinct. The symbolic name is currently only used to affect the expansion of --archive-dir , but may be used for additional features in
# the future. Users running more than one distinct backup are encouraged to use this option. If not specified, the default value is a hash of the backend URL.
os=$(. /etc/os-release 2>/dev/null && printf '%s\n' "${ID:-${NAME:-}}") || true
host=$(uname -n 2>/dev/null) || true
machine_id=$(md5sum /etc/machine-id 2>/dev/null | cut -f1 -d' ') || true # added differential
NAME="full-system-$host-$os-$machine_id"

# The file to backup the list of installed packages to
PACKAGE_LIST="$HOME/.local/state/package_list"

# The source directory *to* backup (usually / or "$HOME")
SOURCE_DIR="$HOME"

# use '-path' to exclude
# use '+path' or just 'path' to include
# spaces are also permitted after the '+/-' (ie '+ path')
# to use a path starting with '-' or '+', simply pass two of them (ie '--path' and '++path')
# NOTE: order is important. the first matching pattern will be applied. (see man duplicity)

# from man:duplicity:
# The include and exclude options accept some extended shell globbing patterns. These patterns can contain '*', '**', '?', and '[...]'.
# As in a normal shell, '*' can be expanded to any string of characters not containing "/", '?' expands to any character except "/",
# and '[...]' expands to a single character of those characters specified (ranges are acceptable).
# The new special pattern, '**', expands to any string of characters whether or not it contains "/".
# Furthermore, if the pattern starts with "ignorecase:" (case insensitive), then this prefix will be removed and
# any character in the string can be replaced with an upper- or lowercase version of itself.
files=(
  "$HOME/.local/state/bash_history"
  "$PACKAGE_LIST"
  # VIVALDI: only backup the things I care about
  "$HOME/.config/vivaldi/Default/History"
  "$HOME/.config/vivaldi/Default/Extensions/"
  "$HOME/.config/vivaldi/Default/Preferences"
  "-$HOME/.config/vivaldi" "-$HOME/.config/vivaldi-static"
  # CLION: I only care about file templates
  "$HOME/.config/JetBrains/CLion2025.2/fileTemplates"
  "-$HOME/.config/JetBrains/CLion2025.2"

  # Exclude large or unimportant files (ie cache)
  "-$HOME/.Xauthority"
  "-$HOME/.cache"
  "-$HOME/.cache/deja-dup"
  "-$HOME/.config/Bitwarden" # electron app
  "-$HOME/.config/Code"      # electron app
  "-$HOME/.config/GIMP"
  "-$HOME/.config/gnupg"
  "-$HOME/.config/ibus"
  "-$HOME/.config/java/.java/.userPrefs/jetbrains"
  "-$HOME/.config/kdeconnect"
  "-$HOME/.config/libreoffice"
  "-$HOME/.config/pulse"                     # hardware specific
  "-$HOME/.config/simplescreenrecorder/logs" # log files
  "-$HOME/.config/SideQuest"                 # electron app
  "-$HOME/.config/TabNine"
  "-$HOME/.config/calibre"
  "-$HOME/.config/google-chrome"        # electron app
  "-$HOME/.config/google-chrome-static" # electron app
  "-$HOME/.local/share"
  "-$HOME/.local/share/Trash"
  "-$HOME/.local/state"
  "-$HOME/.luckyBackup/logs"
  "-$HOME/.luckyBackup/snaps"
  "-$HOME/.thunderbird"
  "-$HOME/.var"
  "-$HOME/.vscode"
  "-$HOME/.xsession-errors"
  "-$HOME/Downloads"
  "-$HOME/Games/battlenet"
  "-$HOME/code/repos"
  "-$HOME/snap/*/*/.cache"
  # Exclude cmake build directories (generated by CLion)
  "-**/cmake-build-*/**"
  "-**/node_modules/**"
  # Exclude git repos files. These should usually be able to be restored from the git repo
  # This is possibly dangerous, but it keeps backup sizes much lower with fewer changes.
  "-**/.git/**"
  # Common dangerously large files
  "-**/*.img" "-**/*.iso" "-**/*.img.gz" "-**/*.iso.gz"
)
# Duplicity complains if an ignore pattern is not a subdirectory of the source directory
if [ "$SOURCE_DIR" = / ]; then
  files+=("+$HOME"
    '-/sys' '-/run' '-/proc'
    '-/dev' '-/dev/shm' '-/var/tmp'
    '-/tmp' '-/media' '-/run/media' # don't backup the backup :)
    '-/mnt' '-/**/lost+found' '-**'
  )
fi

# Exclude directories if filename is present. Allows the user to specify folders
# that they do not wish to backup by adding a specified file (e.g. ".nobackup")
# instead of maintaining a comprehensive exclude/include list.
exclude_if_present=(
  'CACHEDIR.TAG'
  '.deja-dup-ignore'
  '.nobackup'
)

# Change the volume size to number MB. Default is 200MB.
VOLSIZE=200

# Currently only 'no' is fully supported.
ENCRYPTION_TYPE=no

# Perform a full backup if an incremental backup is requested, but the latest full backup in the collection is older than the given time.
FULL_IF_OLDER=15D

# Use seconds as the socket timeout value if duplicity begins to timeout during network operations. The default is 30 seconds.
TIMEOUT=120
# Specify output verbosity level (log level).
# Named levels and corresponding values are 0 Error, 2 Warning, 4 Notice (default), 8 Info, 9 Debug (noisiest).
#          level may also be a character: e, w, n, i, d
#          or a word: error, warning, notice, info, debug
# VERBOSITY=8 # default to 8 if stdout is tty, else 4
# [ -t 1 ] || VERBOSITY=4
VERBOSITY=4
# Write specially-formatted versions of output messages to the specified file.  The format used is designed to be easily consumable by other programs.
LOGFILE=

# Delete incremental sets of all backups sets that are older than the count:th last full backup (in other words, keep only old full backups and not their increments).
# count must be larger than zero. A value of 1 means that only the single most recent backup chain will be kept intact.
REMOVE_ALL_INC_OF_BUT_N_FULL=3
# Delete all backup sets older than the given time.  Old backup sets will not be deleted if backup sets newer than time depend on them.
# See the TIME FORMATS section for more information.
REMOVE_OLDER_THAN=3M

# When backing up or restoring, this option specifies that the local archive directory is to be created in path.
# If the archive directory is not specified, the default will be to create the archive directory in ~/.cache/duplicity/.
# ARCHIVE_DIR=~/.cache/duplicity/

# Use this existing directory for duplicity temporary files instead of the system default, which is usually the /tmp directory.
# TEMP_DIR=/tmp

# Set to 0 to disable verification (speeds up a lot)
BACKUP_VERIFY=${BACKUP_VERIFY:-1}

# ----------------------------------------------------------------
# ----------------------------------------------------------------
# -------------------------- PROCESSING --------------------------
# ----------------------------------------------------------------
# ----------------------------------------------------------------

THIS="$(basename -- "${BASH_SOURCE[0]}")"
function usage() {
  cat <<EOF || true
Usage: $THIS [opts]...
Run a system backup using duplicity.
Pass --full to specify full backup or --incr to specify incremental backup
If neither argument is passed, a full will be made if the most recent full backup is $FULL_IF_OLDER old

Options:
  --incr                    Force a incremental backup
  --full                    Force a full backup
  --no-verify               Do not verify the backup
  -h, --help                Show this message
  -c, --cleanup             Cleanup old backups
  -i, --info                A synonym for --status
  -n, --dry-run             Do not run any duplicity commands, just show them
  -p, --print               Print information about the backup without querying it
  -s, --status              Get the collection-status
  -v, --verbose             Show all duplicity commands before running them
  --force-destination-uri   Force the passed destination URI to be used to backup without user confirmation.
                            It is an error to pass this option without --destination-uri.
  --destination-uri <uri>   The directory to backup to.
                            This should only be used when you *really* know what you're doing.
                            To change the destination URI in a script, you *must* pass --force-destination-uri.
                            Note that this is only allowed when mode != 'backup' or the user is present to confirm or --force-destination-uri is passed.

Environment Variables:
  BACKUP_VERBOSE: act as if --verbose was passed
  BACKUP_DRY_RUN: act as if --dry-run was passed
  BACKUP_VERIFY: if set to 0, act as if --no-verify was passed
  DUPLICITY: The path to the duplicity executable
EOF
}

# Array of arguments to pass to duplicity
# Slightly safer options
args=(--exclude-other-filesystems --exclude-device-files)

LONGOPTS=incr,full,help,cleanup,info,dry-run,print,status,verbose,destination-uri:,force-destination-uri,no-verify
SHORTOPTS=h,c,i,n,p,s,v
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit
mode=backup
command=() # an array for the sake of empty strings (allows to skip the command and dynamically create full backups)
_changed_destination_uri=
force_destination_uri=0
while true; do
  arg="$1" && shift 1 # Shift to remove the option - if it has an argument, it will be in $1
  case "$arg" in
  --full | --incr) command=("${arg#--}") ;;
  # These three are intentionally long options so they aren't accidentally passed by users
  # These are very dangerous if used incorrectly
  --force-destination-uri) force_destination_uri=1 ;;
  # If a url is passed, don't set the name (duplicity will hash the url as the name)
  --destination-uri) _changed_destination_uri="$1" NAME="" && shift 1 ;; # Shift to remove the value
  ## End of dangerous options
  --help | -h) usage && exit 0 ;;
  --print | -p) mode=print ;;
  --cleanup | -c) mode=cleanup ;;
  --info | -i) ;& # fallthrough
  --status | -s) mode=status ;;
  --dry-run | -n) BACKUP_DRY_RUN=1 ;; # overrides environment variables
  --verbose | -v) BACKUP_VERBOSE=1 ;; # overrides environment variables
  --no-verify) BACKUP_VERIFY=0 ;;
  --) break ;;
  *) abort "this is a bug" 3 ;;
  esac
done
[ "$#" -le 1 ] || abort "usage: $THIS [opts]... [host]" 2

if [ -n "$_changed_destination_uri" ]; then
  DESTINATION_URI="$_changed_destination_uri"
else
  if [ "$#" -eq 0 ]; then
    # Searching for usb drive
    external=

    # maj:min, LABEL=label, UUID=uuid, PARTLABEL=label, PARTUUID=uuid
    usbdevice=UUID=e9dff24c-bba3-424e-9855-79e4b2883488
    usbname=Backup # The directory name it is automounted under
    usbdirectory=/mnt/backup/

    # Search for a mountpoint - uuid, label, or partition label
    if [ -z "$external" ] && [ -n "$usbdevice" ] && command -v findmnt &>/dev/null; then
      external=$(findmnt -nr -o target -S "$usbdevice") || true
    fi
    # Search by name - automounted (label)
    if [ -z "$external" ] && [ -n "$usbname" ]; then
      for dir in "/media/$USER" "/run/media/$USER"; do
        [ -d "$dir/$usbname" ] || continue
        external="$dir/$usbname" && break
      done
    fi
    # Search by mounted directory - automounted (constant directory)
    if [ -z "$external" ] && [ -d "$usbdirectory" ]; then
      if findmnt -M "$usbdirectory" &>/dev/null; then
        external="$usbdirectory"
      fi
    fi

    if ! [ -d "$external" ]; then
      abort "Could not find the backup directory!" 1
    fi
    log "Found external backup directory: $external"
    uri_base=file://$external
  else
    uri_base=rsync://$1//backup
  fi
  # The destination directory to backup *to* (usually a remote location or external storage)
  DESTINATION_URI=$uri_base/duplicity_backup/$host-$os
fi

DUPLICITY="${DUPLICITY:-"$(cmdpath duplicity || true)"}"
# Ensure duplicity can be accessed
if [ "$mode" != "print" ]; then # This is a special case. We don't want to error out!
  if [ -z "$DUPLICITY" ]; then
    abort "Could not find duplicity. Please ensure it is installed" 1
  elif ! [ -x "$DUPLICITY" ]; then
    abort "Could not run '$DUPLICITY'. Please ensure it is executable." 3
  fi
fi

# Encryption
if [ "${ENCRYPTION_TYPE:-}" = 'no' ]; then
  args+=("--no-encryption")
elif [ -n "${ENCRYPTION_TYPE:-}" ]; then
  # Don't abort here. Try it, but it probably won't work
  err "Warning: Encryption type '${ENCRYPTION_TYPE}' is not supported"
fi

# If -v is passed, increase verbosity
if [ "${BACKUP_VERBOSE:-}" = 1 ]; then VERBOSITY=8; fi
# verbosity
if [ -n "${VERBOSITY:-}" ]; then
  args+=("--verbosity=$VERBOSITY")
fi

# archive-dir
if [ -n "${ARCHIVE_DIR:-}" ]; then
  args+=("--archive-dir=$ARCHIVE_DIR")
fi

# tempdir
if [ -n "${TEMP_DIR:-}" ]; then
  args+=("--tempdir=$TEMP_DIR")
fi

# log-file
if [ -n "${LOGFILE:-}" ]; then
  args+=("--log-file=$LOGFILE")
fi

# name
if [ -n "${NAME:-}" ]; then
  args+=("--name=$NAME")
fi

# ----------------------------------------------------------------
# ----------------------------------------------------------------
# -------------------------- EXECUTION ---------------------------
# ----------------------------------------------------------------
# ----------------------------------------------------------------

# Opt into color if stdout is a terminal
USE_COLOR=1
# IF BACKUP_DRY_RUN is set, don't actually run anything
[ -z "${BACKUP_DRY_RUN:-}" ] || USE_DRY_RUN=1
# If BACKUP_VERBOSE is *not* set, don't be verbose
[ -n "${BACKUP_VERBOSE:-}" ] || USE_VERBOSE=0

did_something=0
# Sets did_something and verbosely runs "$@"
function run() {
  did_something=1
  verbose "$@"
}

[ "${#args[@]}" -gt 0 ] || abort "No arguments were specified. Something went wrong" 3

# Store the args for verify
verify_args=("${args[@]}")
case "$mode" in
backup | print) # setup args for print to ensure proper output
  # include/exclude
  for pat in "${files[@]}"; do
    case "$pat" in
    '- '*) args+=("--exclude=${pat#- }") ;; # '- path' -> '--exclude=path'
    -*) args+=("--exclude=${pat#-}") ;;     # '-path' -> '--exclude=path'

    '+ '*) args+=("--include=${pat#+ }") ;; # '+ path' -> '--include=path'
    +*) args+=("--include=${pat#+}") ;;     # '+path' -> '--include=path'

    *) args+=("--include=$pat") ;; # 'path' -> 'include=path'
    esac
  done

  # exclude-if-present
  # check is set and not empty
  # note: "${!var[@]}" returns the indicies (ie 0 1 2 3) for the full array
  if [ -n "${!exclude_if_present[*]}" ]; then
    for file in "${exclude_if_present[@]}"; do
      args+=("--exclude-if-present=$file")
    done
  fi

  # volsize
  if [ -n "${VOLSIZE:-}" ]; then
    args+=("--volsize=$VOLSIZE")
  fi
  # timeout
  if [ -n "${TIMEOUT:-}" ]; then
    args+=("--timeout=$TIMEOUT")
  fi
  ;;
esac

# like declare -p, but nicer output
print_array() {
  for name in "$@"; do
    declare -n array="$name"
    local array=("${array[@]}")
    printf '%s\n' "declare -${array@a} $name=("
    printf '  %s %s %s %s\n' "${array[@]@Q}"
    printf ')\n'
  done
}

function list_packages() {
  printf '%s\n' "#!/usr/bin/env bash"
  printf '%q ' printf '%s\n' "set -euC -o pipefail" && printf '\n'
  printf '%q ' printf '%s\n' "Installing packages from backup..." && printf '\n'
  # Note: Order matters!
  local pkg_managers=(
    yay paru pacman # Arch / Manjaro
    apt             # Debian / Ubuntu
  )
  local pkg_manager
  pkg_manager="$(first_cmd "${pkg_managers[@]}")" || true
  case "$pkg_manager" in
  yay | paru | pacman)
    local args=(-Qq)
    [ "$pkg_manager" != pacman ] || args+=(-n) # only show native packages if using pacman
    # shellcheck disable=SC2034
    {
      local explicit_deps=() auto_deps=()
      mapfile -t explicit_deps < <("$pkg_manager" "${args[@]}" -e)
      mapfile -t auto_deps < <("$pkg_manager" "${args[@]}" -d)
      print_array explicit_deps auto_deps
    }

    printf '%s\n' "${pkg_manager@Q} -S --needed --asexplicit -- \"\${explicit_deps[@]}\""
    printf '%s\n' "${pkg_manager@Q} -D --asdeps -- \"\${explicit_deps[@]}\""
    printf '%s\n' "${pkg_manager@Q} -S --needed --asdeps -- \"\${auto_deps[@]}\""
    ;;
  apt)
    has apt-mark || abort "apt-mark is not installed. Please install it" 3
    # shellcheck disable=SC2034
    {
      local explicit_deps=() auto_deps=()
      mapfile -t explicit_deps < <(apt-mark showmanual)
      mapfile -t auto_deps < <(apt-mark showauto)
      print_array explicit_deps auto_deps
    }

    printf '%s\n' "${pkg_manager@Q} install -- \"\${explicit_deps[@]}\""
    printf '%s\n' "${pkg_manager@Q} install --mark-auto -- \"\${auto_deps[@]}\""
    ;;
  '') err "Could not determine package manager. To add support, add a case statement to list_pacakges()" ;;
  # This means it was added to the list of package managers but not the case statement
  *) abort "Unknown package manager '$pkg_manager'. This is most likely a bug." 3 ;;
  esac
}

case "$mode" in
backup)
  if [ -n "$_changed_destination_uri" ]; then
    warn "WARNING: The destination URI was changed to $DESTINATION_URI"
    warn "If this is not the correct URI, you will lose data from the old backup!"
    if [ "$force_destination_uri" -eq 0 ]; then
      # Ensure stdin is a terminal and the user wants to continue
      if ! { [ -t 0 ] && confirm "Are you sure you want to continue?" n; }; then
        abort "Aborting backup due to mismatched destination URI" 1
      fi
    fi
  fi

  log ''
  log "--- Backup at $(date) ---"
  log ''

  log "Backing up package list to $PACKAGE_LIST"
  list_packages >|"$PACKAGE_LIST"

  if [ -t 1 ]; then args+=("--progress"); fi

  log "Backing up to $DESTINATION_URI"
  run "$DUPLICITY" --full-if-older-than="${FULL_IF_OLDER:-1M}" "${command[@]}" "${args[@]}" "$SOURCE_DIR" "$DESTINATION_URI"
  ;;
cleanup)
  log "Cleaning up $DESTINATION_URI"
  if [ -n "${REMOVE_OLDER_THAN:-}" ]; then # only if defined
    log "Removing backups older than $REMOVE_OLDER_THAN"
    command=(remove-older-than "$REMOVE_OLDER_THAN" --force)
    run "$DUPLICITY" "${command[@]}" "${args[@]}" "$DESTINATION_URI"
  fi
  if [ -n "${REMOVE_ALL_INC_OF_BUT_N_FULL:-}" ]; then # only if defined
    log
    log "Removing all incremental backups except for $REMOVE_ALL_INC_OF_BUT_N_FULL of full at $DESTINATION_URI"
    command=(remove-all-inc-of-but-n-full "$REMOVE_ALL_INC_OF_BUT_N_FULL" --force)
    run "$DUPLICITY" "${command[@]}" "${args[@]}" "$DESTINATION_URI"
  fi
  ;;
status)
  command=(collection-status)
  run "$DUPLICITY" "${command[@]}" "${args[@]}" "$DESTINATION_URI"
  exit 0 # Don't verify the backup
  ;;
print)
  # Note: Don't change these headers!
  # Note: The format should always be '%s: %s'
  # Note: This should be human readable, but also should be script compatible
  # Note: Parse these with `grep '^Name: ' | sed 's/^Name: \(.*\)/\1/'`
  log "Name: ${NAME:-}"
  log "Backup location: ${DESTINATION_URI:-}"
  log "Source location: ${SOURCE_DIR:-}"
  log "Archive location: ${ARCHIVE_DIR:-}"
  log "Tmp location: ${TEMP_DIR:-}"
  log "Log file: ${LOGFILE:-}"
  log "Duplicity executable: ${DUPLICITY:-}"
  log "Verbosity: ${VERBOSITY:-}"
  log "Encryption type: ${ENCRYPTION_TYPE:-}"
  log "Volume size: ${VOLSIZE:-}"
  log "Full if older than: ${FULL_IF_OLDER:-}"
  log "Timeout: ${TIMEOUT:-}"
  # One option per line
  # This *must* be last beause the number of lines is unknown
  log "Duplicity Options:" "${args[@]}"
  exit 0
  ;;
*) abort "Unknown mode '$mode'. This is most likely a bug." 3 ;;
esac
[ "$did_something" -eq 1 ] || abort "Didn't do anything. Please check your configuration and try again." 2
[ "$BACKUP_VERIFY" -ne 0 ] || exit 0 # We're done here.

log
log "Verifying $DESTINATION_URI"
verbose "$DUPLICITY" verify "${verify_args[@]}" "$DESTINATION_URI" "$SOURCE_DIR"
