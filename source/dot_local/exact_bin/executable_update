#!/usr/bin/env bash

# ~/.local/bin/update-java
#
# Updates java symlinks to the path specified using update-alternatives
#
set -euC -o pipefail

THIS=update
usage() {
  cat <<EOF
$THIS [OPTIONS]... -- [METHOD]...
Update system packages and third party packages
If no method is specified, all packages will be updated
This is meant to help avoid forgetting a method,
not to force yes, or any other convience
Use \$SUDO to override the sudo command, and use
METHOD_ARGS to pass additional options to each command. (IE, NATIVE_ARGS)
Currently supported methods are: native, snap, flatpak, pnpm, npm
use 'native' to enable or '+native' to disable. ORDER MATTERS!
Options:
--as-root: allow running as root (Discouraged!)
EOF
  EOF
  return 0
}

# COLOR vars to keep from branching to tput repeatedly
RED_COLOR="$(tput setaf 1 2>/dev/null)"
YELLOW_COLOR="$(tput setaf 11 2>/dev/null)"
GREEN_COLOR="$(tput setaf 2 2>/dev/null)"
BOLD_COLOR="$(tput bold 2>/dev/null)"
RESET_COLOR="$(tput sgr0 2>/dev/null)"

log() { printf "$YELLOW_COLOR$BOLD_COLOR%s\n$RESET_COLOR" "$@"; }
show_run() {
  log "running: $*"
  "$@"
}
err() { printf "${THIS:+$THIS:}$RED_COLOR$BOLD_COLOR%s\n$RESET_COLOR" "$@" >&2; }
success() { printf "$GREEN_COLOR$BOLD_COLOR%s$RESET_COLOR\n" "Success!"; }
abort() { err "$1" && exit "${2:-1}"; }

# Returns a string that should be 'eval'ed to set the positional arguments
# Store the string in a variable (ie ARGSTRING) to maintain the exit code if parse_args fails.
# Input: $LONGOPTS,$SHORTOPTS
# eval "$(parse_args "$@")"
function parse_args() {
  # -allow a command to fail with !’s side effect on errexit
  # -use return value from ${PIPESTATUS[0]}, because ! hosed $?
  # shellcheck disable=SC2251
  ! getopt --test >/dev/null
  if [[ "${PIPESTATUS[0]}" -ne 4 ]]; then abort "Enhanced getopt is required for this script to work. Please install it." 1; fi

  local parsed
  if parsed=$(getopt --options="$SHORTOPTS" --longoptions="$LONGOPTS" --name "${THIS-$0}" -- "$@"); then
    # output getopt’s output this way to handle the quoting right:
    printf '%s' "set -- $parsed"
    return 0
  fi
  # getopt has already complained about wrong arguments to stdout - Exit script
  exit 2
}

LONGOPTS=help,as-root,list SHORTOPTS=h,l
ARGSTRING="$(parse_args "$@")"
eval "$ARGSTRING"

allow_root=0
while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  --as-root) allow_root=1 && shift 1 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

if [ "$EUID" -eq 0 ] && [ "$allow_root" -eq 0 ]; then
  err 'This script should not be run as root (due to flatpak).'
  err 'Use SUDO environment variable to override sudo program.'
  err 'Use update --as-root to force the script to run as root'
  exit 2
fi

native=0 flatpak=0 snap=0 pnpm=0 npm=0
if [ "$#" -eq 0 ]; then
  native=1 flatpak=1 snap=1 pnpm=1 npm=1
else
  for arg; do
    case "${arg,,}" in # Allow `native` to enable or `native-` to disable. ORDER MATTERS!
    apt | nala | pacman | native) native=1 ;;
    +apt | +nala | +pacman | +native) native=0 ;;
    flatpak) flatpak=1 ;; +flatpak) flatpak=0 ;;
    snap) snap=1 ;; +snap) snap=0 ;;
    pnpm) pnpm=1 ;; +pnpm) pnpm=0 ;;
    npm) npm=1 ;; +npm) npm=0 ;;
    all) native=1 flatpak=1 snap=1 pnpm=1 npm=1 ;;
    +all) native=0 flatpak=0 snap=0 pnpm=0 npm=0 ;;
    esac
  done
fi

# Environment variables
SUDO=${SUDO:-sudo}
# shellcheck disable=SC2206 # Splitting would otherwise happen on the command line, so this is not *my* problem.
{
  NATIVE_ARGS=(${NATIVE_ARGS:-})
  FLATPAK_ARGS=(${FLATPAK_ARGS:-})
  SNAP_ARGS=(${SNAP_ARGS:-})
  PNPM_ARGS=(${PNPM_ARGS:-})
  NPM_ARGS=(${NPM_ARGS:-})
}

cmd_available() { command -v "$@" &>/dev/null; }

if [ "$native" -eq 1 ]; then
  log "Updating native packages!"
  if cmd_available nala; then
    log "Using nala"
    show_run "$SUDO" nala upgrade "${NATIVE_ARGS[@]}"
  elif cmd_available apt; then
    log "Using apt"
    show_run "$SUDO" apt update "${NATIVE_ARGS[@]}" && "$SUDO" apt upgrade "${NATIVE_ARGS[@]}"
  elif cmd_available pacman; then
    log "Using pacman"
    show_run "$SUDO" pacman -Syu "${NATIVE_ARGS[@]}" # READ THIS!
  elif cmd_available dnf; then
    log "Using dnf"
    show_run "$SUDO" dnf upgrade "${NATIVE_ARGS[@]}"
  fi
  success
fi

if [ "$snap" -eq 1 ] && cmd_available snap; then
  log "Updating snap packages!"
  log
  show_run "$SUDO" snap refresh "${SNAP_ARGS[@]}"
  success
fi

if [ "$flatpak" -eq 1 ] && cmd_available flatpak; then
  log "Updating flatpak packages!"
  log
  show_run flatpak update "${FLATPAK_ARGS[@]}" # NOT as root!
  success
fi

if [ "$pnpm" -eq 1 ] && cmd_available corepack; then
  log "Updating pnpm!"
  log
  show_run corepack prepare pnpm@latest --activate
  success
fi

if [ "$pnpm" -eq 1 ] && cmd_available pnpm; then
  log "Updating pnpm packages!"
  log
  show_run pnpm upgrade -g --latest # NOT as root!
  pnpm_root=0
  for f in /root/.local/share/pnpm/global/*/package.json; do
    if [ -f "$f" ]; then pnpm_root=true && break; fi
  done
  [ "$pnpm_root" -eq 1 ] && show_run "$SUDO" pnpm update -g --latest "${PNPM_ARGS[@]}"
  success
fi

if [ "$npm" -eq 1 ] && cmd_available npm; then
  log "Updating npm packages!"
  log
  if cmd_available ncu; then
    show_run ncu -p npm -g # get them to latest
  else
    log "install 'ncu' to improve this experience"
  fi
  show_run npm upgrade -g "${NPM_ARGS[@]}" # NOT as root!
  success
fi
