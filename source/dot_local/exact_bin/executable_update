#!/usr/bin/env bash
# ~/.local/bin/update
#
# Updates the system, including as many possible sources as possible
#
set -euC -o pipefail
shopt -s nullglob globstar # Better globs
. script_utils.sh || exit
USE_COLOR=1 # Colorize output
THIS=$(basename -- "${BASH_SOURCE[0]}")
function usage() {
  cat <<EOF
$THIS [opts] [METHODS]
Update system and third party packages
If no method is specified, all packages will be updated
use 'method' to enable or '+method' to disable. ORDER MATTERS!

Options:
  -h, --help     Show this help message.
  -l, --list     List all methods
  --as-root      Allow running as root (Discouraged!)
EOF
  return 0
}

LONGOPTS=help,as-root,list SHORTOPTS=h,l
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit

# This is the main driver for available methods!
# To add a method, add it here, then add it to the case statement below
declare -A methods=(
  [native]=0
  [flatpak]=0
  [snap]=0
  [pnpm]=0
  [npm]=0
  [cargo]=0
  [vmware]=0
  [chezmoi]=0
)

allow_root=0
while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  --as-root) allow_root=1 && shift 1 ;;
  -l | --list)
    log "Available methods are: "
    printf "%s\n" "${!methods[@]}" | sort
    exit 0
    ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

if [ "$(id -u)" -eq 0 ] && [ "$allow_root" -eq 0 ]; then
  err 'This script should not be run as root (due to flatpak).'
  err 'Use SUDO environment variable to override sudo program.'
  err 'Use update --as-root to force the script to run as root'
  exit 2
fi

all_exclude=1 # If all are exclude, enable all by default
for arg; do
  case "$arg" in
  +*) trude ;;        # Nothing
  *) all_exclude=0 ;; # Not an exlude.
  esac
done

# by default, or if all given are exclude patterns, enable all methods
if [ "$#" -eq 0 ] || [ "$all_exclude" -eq 1 ]; then
  for m in "${!methods[@]}"; do methods["$m"]=1; done
fi

for arg; do # Doesn't do anything if $# is zero
  method="${arg,,}"
  case "$method" in # Allow `native` to enable or `native-` to disable. ORDER MATTERS!
  all) for m in "${!methods[@]}"; do methods["$m"]=1; done ;;
  +all) for m in "${!methods[@]}"; do methods["$m"]=0; done ;;
  +*) # disable pattern
    [ -n "${methods["$method"]:-}" ] || abort "Unknown method: $method" 2
    methods["$method"]=0
    ;;
  *) #enable pattern
    [ -n "${methods["$method"]:-}" ] || abort "Unknown method: $method" 2
    methods["$method"]=1
    ;;
  esac
done

to_update=()
for m in "${!methods[@]}"; do
  [ "${methods[$m]}" -eq 1 ] || continue
  to_update+=("$m")
done
if [ "${#to_update}" -eq 0 ]; then log "Nothing to do" && exit 0; fi

for m in "${to_update[@]}"; do
  case "$m" in
  native)
    native_cmd=$(first_cmd nala apt yay pacman dnf) || { err "Could not find a command to update native packages." && continue; }
    log "Using $native_cmd to update native packages"
    case "$native_cmd" in
    nala) verbose sudo_cmd nala upgrade ;;
    apt) verbose sudo_cmd apt update && verbose sudo_cmd apt upgrade ;;
    yay) verbose yay -Syu ;;
    pacman) verbose sudo_cmd pacman -Syu ;;
    dnf) verbose sudo_cmd dnf upgrade ;;
    esac
    ;;
  snap)
    has_cmd snap || contine
    log "Updating snap packages!"
    verbose sudo_cmd "$(cmdpath snap)" refresh
    success

    has_cmd snap-cleanup || contine
    log "Cleaning up snap packages"
    verbose sudo_cmd "$(cmdpath snap-cleanup)" -y
    success
    ;;
  flatpak)
    has_cmd flatpak || continue
    log "Updating flatpak packages!"
    verbose "$(cmdpath flatpak)" update # NOT as root!
    success
    ;;
  npm)
    if has_cmd n; then # Note: n is optional
      log "Updating npm!"
      verbose sudo_cmd "$(cmdpath n)" -d lts             # download
      verbose sudo_cmd "$(cmdpath n)" -d latest          # download
      node_latest=$(n ls-remote latest)                  # 1.1.1
      node_current=$(node --version 2>/dev/null || true) # v1.1.1
      if [ "v$node_latest" != "$node_current" ]; then    # only if not already active
        verbose sudo_cmd "$(cmdpath n)" latest           # activate latest
      fi
      success
    fi

    has_cmd npm || continue
    log "Updating npm packages!"
    if has_cmd ncu; then
      verbose "$(cmdpath ncu)" -p npm -g # get them to latest
    else
      log "install 'ncu' to improve this experience"
    fi
    verbose "$(cmdpath npm)" upgrade -g # NOT as root!
    success
    ;;
  pnpm)
    # NOTE: nodejs < 20.x.x is broken on my machine, as this corepack can't access npm.org
    #This is fixed by updating to latest before updating pnpm - see above.
    if has_cmd corepack; then
      log "Updating pnpm!"
      verbose "$(cmdpath corepack)" prepare pnpm@latest --activate
      success
    fi

    has_cmd pnpm || continue
    log "Updating pnpm packages!"
    verbose "$(cmdpath pnpm)" upgrade -g --latest # NOT as root!
    pnpm_root=0
    for f in /root/.local/share/pnpm/global/*/package.json; do
      if [ -f "$f" ]; then pnpm_root=1 && break; fi
    done
    [ "$pnpm_root" -eq 0 ] || verbose sudo_cmd "$(cmdpath pnpm)" update -g --latest
    success
    ;;

  cargo)
    if has_cmd rustup; then
      log "Updating cargo and rustc!"
      verbose "$(cmdpath rustup)" update
      success
    fi

    has_cmd cargo cargo-install-update || continue
    cpumode_before=''
    if has_cmd cpumode; then
      cpumode_before=$(cpumode -c) || err "Failed to get the CPU mode."
      cpumode -q -- 'performance' 2>/dev/null || err "Failed to set the CPU mode to performance."
    fi
    log "Updating cargo installed packages!"
    verbose "$(cmdpath cargo)" install-update --all --git || true # || true to ensure that the cpumode can be restored
    if [ -n "$cpumode_before" ]; then cpumode -q -- "$cpumode_before" 2>/dev/null || err "Failed to restore the CPU mode."; fi
    success
    ;;
  vmware)
    has_cmd vmplayer || continue
    # log "updating vmware using vmware-installer!"
    # verbose sudo_cmd "$(cmdpath vmware-installer)" --console --eulas-agreed
    # success

    # These need to be updated because they break randomly otherwise
    log "updating vmware modconfig!"
    verbose sudo_cmd "$(cmdpath vmware-modconfig)" --console --install-all
    success
    ;;

  chezmoi)
    has_cmd chezmoi || continue
    log "Updating chezmoi"
    chezmoi=$(cmdpath chezmoi)
    verbose "$chezmoi" upgrade --executable "$chezmoi"
    ;;
  *) abort "This is a bug! Found unknown method: $m" 3 ;;
  esac
done
