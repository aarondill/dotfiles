#!/usr/bin/env bash
# this is a hack to make desktop files with Terminal=true open in the right application
set -euC -o pipefail
terms=(xdg-terminal-exec x-terminal-emulator wezterm gnome-terminal xterm)
GNOME_TERM=/usr/bin/gnome-terminal
if [ "${1:-}" != "--" ] && [ -x "$GNOME_TERM" ]; then
  exec "$GNOME_TERM" "$@"
else
  if [ "${1:-1}" == "--" ]; then shift; fi
  for t in "${terms[@]}"; do # Find first installed terminal application in $terms
    if command -v "$t" &>/dev/null; then break; fi
  done
  if [ -z "$t" ]; then
    echo "Could not find a terminal to run" >&2
    exit 1
  fi
  case "$t" in
  xdg-terminal-exec) exec "$t" "${@:2}" ;;
  *) exec "$t" -e "${@:2}" ;;
  esac
fi
