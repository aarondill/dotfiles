#!/bin/bash
# this is a hack to make desktop files with Terminal=true open in the right application

[ x"$1" = x"--" ] || { exec /usr/bin/gnome-terminal "$@"; exit 0; }

shift

TITLE="$(basename "$1")"
if [ -n "$TITLE" ]; then
  x-terminal-emulator -e "$@"
else
  x-terminal-emulator             -e "$@"
fi
