#!/usr/bin/env bash

# ~/.local/bin/update-java
#
# Updates java symlinks to the path specified using update-alternatives
#
set -euC -o pipefail && shopt -s nullglob globstar
utils=script_utils.sh dir=$(dirname -- "${BASH_SOURCE[0]}") || true
if [ -f "$dir/$utils" ]; then utils="$dir/$utils"; fi
# shellcheck source=./script_utils.sh
. "$utils" || exit

function usage() {
  cat <<EOF || true
$THIS [-y | --yes] <JAVADIR> [priority = 1112] [JVM_VERS_DIR]
Updates java symlinks to the path specified using update-alternatives.
Do not include /bin on JAVADIR.
JVM_VERS_DIR will be determined by JAVA_HOME if set, or else default to /usr/lib/jvm
Note: relies on GNU find

Options:
-y, --yes     don't prompt for confirmation
-q, --quiet   don't output debug info
EOF
}
LONGOPTS=help,yes,quiet SHORTOPTS=h,y,q
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit

yes=0
while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  -y | --yes) yes=1 && shift ;;
  -q | --quiet) USE_VERBOSE=0 && shift ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done
if [ "$#" -eq 0 ]; then usage && exit 2; fi

JAVADIR=${1:-}
PRIORITY=${2:-1112}
BINDIR=/usr/bin
if [ -n "${3:-}" ]; then
  JVM_VERS_DIR=$3
elif [ -n "${JAVA_HOME:-}" ]; then
  JVM_VERS_DIR=$(dirname -- "$JAVA_HOME") # /usr/lib/jvm/jdk-version --> /usr/lib/jvm
else
  JVM_VERS_DIR=/usr/lib/jvm
fi

[ -d "$JVM_VERS_DIR" ] || err "'$JVM_VERS_DIR' is not a directory. It will be created on confirmation" "$JVM_VERS_DIR"
[ -d "$JAVADIR" ] || abort "'$JAVADIR' is not a directory" 2
JAVADIR=$(realpath -- "$JAVADIR")

case "$JAVADIR" in */bin)
  if [ "$yes" -eq 1 ] || confirm "$JAVADIR ends in /bin, would you like to use it's parent?"; then
    JAVADIR=$(dirname -- "$(realpath -- "$JAVADIR")")
  fi
  ;;
esac
[ "$yes" -eq 1 ] || confirm "Are you sure you would like to link all binaries in $JAVADIR?" || abort "Aborting" 1

sudo_cmd mkdir -p "$JVM_VERS_DIR"
JVM_VERS_DIR=$(realpath -- "$JVM_VERS_DIR")

if [ "$(dirname -- "$JAVADIR")" != "$JVM_VERS_DIR" ]; then
  log "Copying files to '$JVM_VERS_DIR'"
  # cp -PpR is posix for cp --archive
  sudo_cmd cp -PpRi -- "$JAVADIR" "$JVM_VERS_DIR/"
  JAVADIR="$JVM_VERS_DIR/$(basename -- "$JAVADIR")"
fi

function link() {
  local dest_path=$1 name=$2 from_path=$3 priority=$4
  if ! has_cmd update-alternatives; then
    # use ln because update-alternatives is not available
    verbose sudo_cmd ln -sf -T "$from_path" "$dest_path"
    return 0
  fi
  verbose sudo_cmd update-alternatives --install "$dest_path" "$name" "$from_path" "$priority"
  verbose sudo_cmd update-alternatives --set "$name" "$from_path"
}

while read -d '' -r -s from_path; do
  name=$(basename -- "$from_path")
  dest_path="$BINDIR/$name"
  link "$dest_path" "$name" "$from_path" "$PRIORITY"
done < <(find "$JAVADIR" -perm /u=x,g=x,o=x -type f -print0)

verbose sudo_cmd ln -sf -T "$JAVADIR" "$JVM_VERS_DIR/default-java"
unset -v cmd
