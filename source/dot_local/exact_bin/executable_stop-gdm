#!/usr/bin/env bash
set -euC -o pipefail

THIS=stop-gdm

usage() {
  cat <<-EOF
usage: $THIS 

stops gdm through systemd multi-user.target
No options or arguments are accepted except --help

the environment variable \`SUDO\` can be set to use a different
program for root elevation. It will be split by the shell, so
spaces in the program name will likely be mutilited.

EOF
}
log() { printf '%s\n' "$@"; }
err() { printf "$THIS: %s\n" "$@" >&2; }
abort() { err "$1" && exit "${2:-1}"; }
# use like `"${sudo[@]}" do_something`
# shellcheck disable=SC2206 # Splitting is intentional.
sudo=(${SUDO:-sudo})
[ "$(id -u)" -eq 0 ] && sudo=()

# Basic arg handling
invalid=false
for arg; do
  case "$arg" in
  --help | -help | -h) usage && exit 0 ;;
  -*) err "unrecognized option '$arg'" && invalid=true ;;
  esac
done
if [ "$invalid" = true ]; then exit 2; fi

exec "${sudo[@]}" systemctl isolate multi-user.target
