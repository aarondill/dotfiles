#!/usr/bin/env bash

# ~/.local/bin/internet
#
# tests internet connection by pinging google.com
set -euC -o pipefail && shopt -s nullglob globstar
utils=script_utils.sh dir=$(dirname -- "${BASH_SOURCE[0]}") || true
if [ -f "$dir/$utils" ]; then utils="$dir/$utils"; fi
# shellcheck source=./script_utils.sh
. "$utils"

test_url=1.1.1.1
function usage() {
  cat <<EOF
usage: $THIS [options] [--] [arguments]
Returns 0 if internet connection is present, else 1

Options:
  -h, --help       show this message
  -t, --test=url   use url/ip instead of $test_url to test internet connection
  -q, --quiet      don't print a message at end of test
EOF
  return 0
}
LONGOPTS=help,test:,quiet SHORTOPTS=h,t:,q
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit
quiet=0
while true; do
  case "$1" in
  --help | -h) usage && exit 0 ;;
  -q | --quiet) quiet=1 && shift ;;
  -t | --test) test_url=$2 && shift 2 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

exit=0
if [ $quiet = true ]; then
  ping -q -c 3 "$test_url" &>/dev/null || exit="$?"
else
  ping -c 3 "$test_url" || exit="$?"
fi

function qlog() { [ "$quiet" -eq 0 ] && log "$@" || return 0; }
function qerr() { [ "$quiet" -eq 0 ] && err "$@" || return 0; }

qlog ''
[ "$exit" -ne 0 ] || { qlog "You have internet!" && exit 0; }

if [ -n "${SOMMELIER_VERSION:-}" ]; then
  qerr "If running in chromeos container, try this to fix a container's connection to it's parent's internet:"
  qerr "Press ctrl+alt+t to open crosh"
  qerr "Run 'vmc start termina'"
  qerr "Run 'lxc network attach lxdbr0 penguin'"
fi

qerr "Your internet connection is not functional"
exit "$exit"
