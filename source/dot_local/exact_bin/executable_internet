#!/usr/bin/env bash

# ~/.local/bin/internet
#
# tests internet connection by pinging google.com
set -euC -o pipefail
. script_utils.sh || exit

test_url=1.1.1.1
function usage() {
  cat <<EOF
usage: $THIS [options] [--] [arguments]
Returns 0 if internet connection is present, else 1

Options:
  -h, --help       show this message
  -t, --test=url   use url/ip instead of $test_url to test internet connection
  -q, --quiet      don't print a message at end of test
EOF
  return 0
}
LONGOPTS=help,test:,quiet SHORTOPTS=h,t:,q
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit
quiet=false
while true; do
  case "$1" in
  --help | -h) usage && exit 0 ;;
  -q | --quiet) quiet=true && shift ;;
  -t | --test) test_url=$2 && shift 2 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

exit=0
if [ $quiet = true ]; then
  ping -q -c 3 "$test_url" &>/dev/null || exit="$?"
else
  ping -c 3 "$test_url" || exit="$?"
fi

if [ "$quiet" != true ]; then
  log ''
  if [ "$exit" -eq 0 ]; then
    log "You have internet!"
  else
    if [ -n "${SOMMELIER_VERSION:-}" ]; then
      err "If running in chromeos container, try this to fix a container's connection to it's parent's internet:"
      err "Press ctrl+alt+t to open crosh"
      err "Run 'vmc start termina'"
      err "Run 'lxc network attach lxdbr0 penguin'"
    fi

    err "Your internet connection is not functional"
  fi
fi
exit "$exit"
