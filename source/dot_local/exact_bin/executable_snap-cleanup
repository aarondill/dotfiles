#!/bin/bash
set -euC -o pipefail
shopt -s nullglob globstar # Better globs
# Find the current file and it's directory # Source: https://stackoverflow.com/a/246128
SOURCE="${BASH_SOURCE[0]:-}" DIR=''
while [ -L "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$(builtin cd -P -- "$(command dirname -- "$SOURCE")" &>/dev/null && builtin pwd)" || true
  SOURCE="$(command readlink -- "$SOURCE")" || true
  [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
DIR="$(builtin cd -P -- "$(command dirname -- "$SOURCE")" &>/dev/null && builtin pwd)" || true
DIR="${DIR:-"$PWD"}" utils="$DIR/script_utils.sh"
[ -f "$utils" ] || utils="$(basename -- "$utils")" || true # If utils is not a file, search for it in "$PATH" instead.
# shellcheck source=./script_utils.sh
. "$utils"             # Note: this may error. I can't use it in a conditional or bashls fails.
[ "$?" -eq 0 ] || exit # set -e means that this line should be irrelevant, but just in case.

# Set English language
export LANG=en_US.UTF-8
THIS="$(basename "$0")"

if [ "$(id -u)" -ne 0 ]; then abort "This program must be run as root" 1; fi

function usage() {
  cat <<EOF
$THIS [options] [--] [arguments]
Cleans up the excess snap revisions and files. Use \$SUDO to change the program used.
the environment variable \`SUDO\` can be set to use a different
program for root elevation. It will be split by the shell, so
spaces in the program name will likely be mutilited.

Options:
-h, --help        show this message
-y, --yes         Don't ask for confirmation
EOF
  return 0
}

LONGOPTS=help,yes SHORTOPTS=h,y
eval "$(parse_args "$@")"

yes=0
while true; do
  case "$1" in
  -h | --help) usage && exit 0 ;;
  -y | --yes) yes=1 && shift ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done

# Current status
USED_BEFORE="$(df -k / | awk 'NR>1 {print $3}')"

if ! has_cmd snap; then abort "snap command not found" 1; fi

[ "$yes" -eq 1 ] ||
  confirm "Do you want to remove unused snapd revisions?" || abort "aborting" 1

# remove unused snapd revisions
log "Removing unused snapd revisions..."
snap set system refresh.retain=2
snap list --all | awk '/disabled/ {print $1, $3}' |
  while read -r SNAP_NAME SNAP_REV; do
    snap remove "${SNAP_NAME}" --revision="${SNAP_REV}"
  done
for file in /var/lib/snapd/cache/*; do rm "$file"; done

# Current status
USED_AFTER="$(df -k / | awk 'NR>1 {print $3}')"

# Summary
log_c "Freed up space: $(((USED_BEFORE - USED_AFTER) / 1024)) MB"
