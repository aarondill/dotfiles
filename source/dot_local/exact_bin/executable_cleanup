#!/usr/bin/env bash
set -euC -o pipefail && shopt -s nullglob globstar
utils=script_utils.sh dir=$(dirname -- "${BASH_SOURCE[0]}") || true
if [ -f "$dir/$utils" ]; then utils="$dir/$utils"; fi
# shellcheck source=./script_utils.sh
. "$utils"

USE_COLOR=1 # We want color in logs here

function get_fs_root() { stat --format '%m' -- "$1"; }
# usage: human_readable [number] [precision]
function human_readable() {
  local p=${2:-2} # default two places
  local args=()
  if [ -n "${1:-}" ]; then args+=("$1"); fi # optional number
  numfmt --to=si --format="%.${p}f" -- "${args[@]}"
}
function get_used_bytes() {
  [ -n "$1" ] || return 2 # Empty string
  [ -e "$1" ] || return 1 # ENOENT
  # -P for posix output, -k for 1024 bytes output(depends on POSIXLY_CORRECT otherwise)
  # Tail to just get line desired
  # Multiply by 1024 to convert from KiB to B -- output with %f to avoid max_int.
  # NOTE: the call to awk could break if the dev file has a space in it...
  df -Pk -- "$1" | tail -n +2 | awk '{printf "%.0f", $3 * 1024}'
}

# Get size before starting

oldsize_root=$(get_used_bytes /) # Convert from KiB to B
oldsize="$oldsize_root"
if [ "$(get_fs_root /)" != "$(get_fs_root ~)" ]; then
  oldsize_home=$(get_used_bytes ~) # Convert from KiB to B
  oldsize=$((oldsize_root + oldsize_home))
fi

# Start doing things

if has_cmd pnpm; then
  log "Cleaning pnpm store"
  (
    cd # pnpm has issues if the current directory is not writable.
    verbose pnpm store prune || true
  )
fi
if has_cmd bun; then
  if [ -n "${BUN_INSTALL:-}" ]; then
    mkdir -p "$BUN_INSTALL/install/global/"
    touch "$BUN_INSTALL/install/global/package.json"
  fi
  log "Cleaning bun cache"
  verbose bun pm -g cache rm
fi

log "Cleaning browser cache"
# Cleaner output
NO_MEASURE_DISK_DIFF=1 verbose clean-google-cache || true

log "Cleaning up cache files"
dirs=(
  ~/.cache/node/corepack/
  ~/.cache/node/corepack/
  ~/.cache/npm/
  ~/.cache/yarn/
  ~/.cache/gnome-desktop-thumbnailer/
  ~/.cache/mesa_shader_cache/
  ~/.cache/node/
)
for d in "${dirs[@]}"; do
  [ -d "$d" ] || continue
  verbose rm -rf -- "$d"
done

log "Cleaning the trash"
if has_cmd trash-empty; then
  verbose trash-empty || true
elif has_cmd gio; then
  verbose gio trash --empty || true
else
  err "Could not find a command to clean the trash"
fi

has_root=1
if [ "$(id -u)" -ne 0 ]; then
  log "Note: the following commands require root access. Running sudo to cache password."
  log "(If you do not have root access, exit the prompt and these actions will be skipped.)"
  sudo_cmd true || has_root=0
fi

if [ "$has_root" -eq 1 ]; then
  if has_cmd snap; then
    log "Cleaning up snap packages"
    verbose sudo_cmd "$(cmdpath snap-cleanup)" -y || true
  fi
  log "Cleaning package manager cache"
  if has_cmd nala; then
    verbose sudo_cmd nala clean || true
  elif has_cmd apt; then
    { verbose sudo_cmd apt-get clean && verbose sudo_cmd apt-get autoclean; } || true
  elif has_cmd yay; then
    verbose yay -Sc || true
  elif has_cmd pacman; then
    verbose sudo_cmd pacman -Sc || true
  else
    err "Could not find a package manager to clean up"
  fi

  if has_cmd flatpak; then
    log "Repairing flatpak repo"
    verbose sudo_cmd flatpak repair || true
  fi

  log "Cleaning old logs >1G"
  verbose sudo_cmd journalctl --vacuum-size=1G || true

  # This should be done last. It will (likely) not free any space, but should still be regularly done
  log "Running TRIM on mounted partitions"
  verbose sudo_cmd fstrim -av || true # this may fail (ex: in container or unsupported fs)
fi

# Size stats
newsize_root=$(get_used_bytes /)
newsize="$newsize_root"
if [ "$(get_fs_root /)" != "$(get_fs_root ~)" ]; then
  newsize_home=$(get_used_bytes ~)
  newsize=$((newsize_root + newsize_home))
fi
saving=$((oldsize - newsize))

log "Old size: $(human_readable "$oldsize")"
log "New size: $(human_readable "$newsize")"
log "Total saving: $(human_readable "$saving")"
