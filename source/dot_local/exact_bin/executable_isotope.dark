#!/usr/bin/env bash
# sets the color of tty using setcolors
# https://github.com/EvanPurkhiser/linux-vt-setcolors
# Sets to isotope.dark (from terminal.sexy)
set -eu

THIS=isotope.dark

log() { printf '%s\n' "$@"; }
err() { printf "$THIS: %s\n" "$@" >&2; }
abort() { err "$1" && exit "${2:-1}"; }
usage() {
  cat <<EOF
$THIS [-h|--help]
Sets the color of tty using setcolors (EvanPurkhiser/linux-vt-setcolors)
Sets to isotope.dark (from terminal.sexy)
Requires setcolors to be in the \$PATH

Options:
-h, --help       show this message
EOF
  return 0
}

# Simple argument parsing, only help supported
for arg in "$@"; do
  case "$arg" in
  --help | -h) usage && exit 0 ;;
  --*) abort "invalid options $arg" 2 ;;
  esac
done

if ! command -v setcolors &>/dev/null; then abort 'setcolors is required for this script to work' 2; fi
setcolors <<<'
0#000000
1#ff0000
2#33ff00
3#ff0099
4#0066ff
5#cc00ff
6#00ffff
7#d0d0d0
8#808080
9#ff0000
10#33ff00
11#ff0099
12#0066ff
13#cc00ff
14#00ffff
15#ffffff
'
