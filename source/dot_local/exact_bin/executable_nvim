#!/usr/bin/env bash
function log() { printf '%s\n' "$@" >&2; } # Log goes to stderr because this is a wrapper
function abort() { log "$1" && exit "${2:-1}"; }

last_broken_commit=3a876bd4
neovim_path=~/code/repos/neovim
neovim="$neovim_path/build/bin/nvim"

log "Using $neovim temporarily because nightly is broken"
log "Remove this when it's been fixed"

if ! [ -x "$neovim" ]; then
  log "File not found. Trying system installation"
  for d in /bin /usr/bin /usr/local/bin; do
    if [ -x "$d/nvim" ]; then exec "$d/nvim" "$@"; fi
  done
  abort "Could not find system installation! Aborting." 1
fi

git -C "$neovim_path" fetch origin >&2
git -C "$neovim_path" hist "$last_broken_commit..origin/master" >&2

export VIMRUNTIME="$neovim_path/runtime/"
exec "$neovim" "$@"
