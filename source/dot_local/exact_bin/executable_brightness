#!/usr/bin/env bash
set -euC -o pipefail
. script_utils.sh || exit

function usage() {
  cat || true <<-EOF
usage: $THIS [OPTS]... [percent]
Sets the brightness to the specified integer percentage. Use n{+,-} to increment the brightness.
Without a percentage, outputs the current brightness percentage
NOTE: 1 is the minimum brightness, while 100 is the maximum brightness

the environment variable \`SUDO\` can be set to use a different
program for root elevation. It will be split by the shell, so
spaces in the program name will likely be mutilited.

Options:
  -h, --help         Show this help message.
  -d, --device=dev   the /sys style device to set the brightness on. \$device/brightness will be writen to!
EOF
}

function is_integer() {
  local number_re='^[0-9]+$'
  [[ "$1" =~ $number_re ]]
}

LONGOPTS="help,device:" SHORTOPTS="h,d:"
ARGSTRING="$(parse_args "$@")" && eval "$ARGSTRING" || exit

device='' show=0
while true; do
  case "$1" in
  --help | -h) usage && exit 0 ;;
  -d | --device) device="$2" && shift 2 ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done
[ "$#" -gt 0 ] || show=1

BrPath="$device"
[ -n "$BrPath" ] || BrPath="$(find /sys/class/backlight -maxdepth 1 -mindepth 1 -print0 | head -zn1 | tr -d '\0')"

[ -n "$BrPath" ] || abort "Unable to find backlight device" 1
[ -d "$BrPath" ] || abort "Found backlight device is not a directory" 1
[ -f "$BrPath/max_brightness" ] || abort "Backlight device must support /max_brightness" 1
[ -f "$BrPath/brightness" ] || abort "Backlight device must support /brightness" 1

BrMax="$(<"$BrPath/max_brightness")" BrCur="$(<"$BrPath/brightness")"
is_integer "$BrMax" || abort "Invalid max brightness '$BrMax'" 2
is_integer "$BrCur" || abort "Invalid current brightness '$BrCur'" 2
declare -i BrMax BrMax BrCur # Cast all to integers
# 100th max-brightness, rounded up to nearest integer
BrMin="$((0 + (BrMax + 100 - 1) / 100))"

[ "$BrMax" -ne 0 ] || abort "Backlight device reported maximum brightness of 0." 1

BrCurRel="$(printf '%s ' "$BrCur" "$BrMax" | awk '{ print int( $1 / $2 * 100 ) }')"

[ "$show" -eq 0 ] || { log "$BrCurRel" && exit 0; }

{ BrNewRel="${1:-}" && [ -n "$BrNewRel" ]; } || abort "Brightness can't be empty" 2
suf='' && case "$BrNewRel" in
+* | *+) suf=+ ;;
-* | *-) suf=- ;;
esac
BrNewRel=${BrNewRel%-} BrNewRel=${BrNewRel#-} BrNewRel=${BrNewRel%+} BrNewRel=${BrNewRel#+} BrNewRel=${BrNewRel%\%}
is_integer "$BrNewRel" || abort "Invalid brightness '$BrNewRel'" 2
case "$suf" in
+) BrNewRel=$((BrCurRel + BrNewRel)) ;;
-) BrNewRel=$((BrCurRel - BrNewRel)) ;;
esac

BrNew="$(printf '%s ' "$BrNewRel" "$BrMax" | awk '{ print int( ( ($1/100) * $2) ) }')"
BrNew="$((BrNew < BrMin ? BrMin : BrNew))"
BrNew="$((BrNew > BrMax ? BrMax : BrNew))"

if [ -w "$BrPath/brightness" ]; then
  printf '%s' "$BrNew" >|"$BrPath/brightness"
else
  printf '%s' "$BrNew" | sudo_cmd tee "$BrPath/brightness" >/dev/null
fi
