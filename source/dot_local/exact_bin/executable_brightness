#!/usr/bin/env bash

set -euC -o pipefail

THIS=brightness

usage() {
  cat <<-EOF
usage: $THIS [percent]
       $THIS show

sets the brightness to the specified integer percentage.
what is done depends on the arguments passed:
  'show':              outputs current brightness percentage.
  integer percentage:  the brightness will be set to the specified percentage
  no argument:         a percentage will be retrieved graphically from the user

EOF
}

log() { printf '%s\n' "$@"; }
err() { printf "$THIS: %s\n" "$@" >&2; }
abort() { err "$1" && exit "${2:-1}"; }

# Returns a string that should be 'eval'ed to set the positional arguments
# Store the string in a variable (ie ARGSTRING) to maintain the exit code if parse_args fails.
# Input: $LONGOPTS,$SHORTOPTS
# eval "$(parse_args "$@")"
function parse_args() {
  # -allow a command to fail with !’s side effect on errexit
  # -use return value from ${PIPESTATUS[0]}, because ! hosed $?
  # shellcheck disable=SC2251
  ! getopt --test >/dev/null
  if [[ "${PIPESTATUS[0]}" -ne 4 ]]; then abort "Enhanced getopt is required for this script to work. Please install it." 1; fi

  local parsed
  if parsed=$(getopt --options="$SHORTOPTS" --longoptions="$LONGOPTS" --name "${THIS-$0}" -- "$@"); then
    # output getopt’s output this way to handle the quoting right:
    printf '%s' "set -- $parsed"
    return 0
  fi
  # getopt has already complained about wrong arguments to stdout - Exit script
  exit 2
}

show=false
LONGOPTS=help,show SHORTOPTS=h,s
ARGSTRING="$(parse_args "$@")"
eval "$ARGSTRING"

while true; do
  case "$1" in
  --help | -h) usage && exit 0 ;;
  -s | --show) show=true && shift ;;
  --) shift && break ;;
  *) abort "This is a bug" 3 ;;
  esac
done
if [ "${1:-}" = show ]; then show=true; fi

BrPath=$(find /sys/class/backlight -maxdepth 1 -mindepth 1 -print0 | head -zn1 | tr -d '\0')
BrMax=$(cat "$BrPath/max_brightness")
# 100th max-brightness, rounded up to nearest integer
BrMin=$((0 + (BrMax + 100 - 1) / 100))
BrCur=$(cat "$BrPath/brightness")

BrCurRel=$(printf '%s ' "$BrCur" "$BrMax" | awk '{ print int( $1 / $2 * 100 ) }')

if [ "$show" = true ]; then
  log "$BrCurRel"
  exit 0
fi

# First arg, or menu
BrNewRel=${1:-}
number_re='^[0-9]+$'
if [ "$#" -eq 0 ]; then
  if command -v yad 2>/dev/null >/dev/null; then
    BrNewRel=$(yad --scale --min-value 0 --max-value 100 --value "$BrCurRel" --print-partial --title 'Set brightness' --width 300 --fixed --sticky --mouse --on-top --escape-ok --button OK --hide-value)
  elif command -v dialog 2>/dev/null >/dev/null; then
    BrNewRel=$(dialog --erase-on-exit --rangebox Brightness -1 -1 0 100 "$BrCurRel" 3>&1 1>&2 2>&3)
  else
    abort "Could not find a program to request brightness from user. Please pass a positional argument." 1
  fi
fi
if ! [[ "$BrNewRel" =~ $number_re ]]; then
  abort "Invalid brightness '$BrNewRel', brightness must be an integer between 0 and 100" 2
fi
if [ -z "$BrNewRel" ]; then exit 1; fi

BrNew=$(printf '%s ' "$BrNewRel" "$BrMax" | awk '{ print int( ( ($1/100) * $2) ) }')
BrNew=$((BrNew < BrMin ? BrMin : BrNew))
BrNew=$((BrNew > BrMax ? BrMax : BrNew))

sudo=""
if ! [ -w "$BrPath"/brightness ]; then sudo="sudo"; fi

printf '%s' "$BrNew" | $sudo tee "$BrPath/brightness" >/dev/null
