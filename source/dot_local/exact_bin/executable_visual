#!/usr/bin/env bash
set -euC -o pipefail
# usage: visual awesome :2 || visual :3 || visual || visual awesome args -- :3
THIS=visual
usage() {
  cat <<EOF || return 0
$THIS [client] [client-args --] [:display] 

if run without arguments, x-window-manager will be used
server will be found in the \$PATH. 
if \$2 is not a valid server and a client is provided,
the arguments will be passed directly to the startx script
EOF
}

log() { printf '%s\n' "$@"; }
err() { printf "${THIS:-}: %s\n" "$@" >&2; }
abort() { err "$1" && exit "${2:-1}"; }
cmd() { command -v "$@" &>/dev/null; }

if ! cmd which; then abort "which is required for this script" 1; fi
if ! cmd startx; then abort "startx is required for this script" 1; fi

for arg in "$@"; do
  case "$arg" in
  -h | --help) usage && exit 0 ;;
  esac
done

wm=${1:-}
server=${2-}
rest=("${@:3}")

disp_regex="^:[[:digit:]]+$"

# visual -- [:3] --server-args
if [ "$wm" == '--' ]; then
  wm=
  server=--
  rest=("${@:2}") # [:3] --server-args
fi

# visual :3
if [ -z "$server" ] && [[ "$wm" =~ $disp_regex ]]; then server="$wm" wm=''; fi

# visual :3 OR visual awesome
if [ -z "$wm" ]; then
  if [ -x "$(command -v x-window-manager)" ]; then
    wm=x-window-manager
  elif [ -x "$(command -v x-terminal-emulator)" ]; then
    wm=x-terminal-emulator
  fi
fi

if wmpath=$(which "$wm" 2>/dev/null); then :; else
  printf '%s\n' "Unable to find $wm in \$PATH" >&2
  exit 2
fi

# HACK: startx on ubuntu still unsets DBUS_SESSION_BUS_ADDRESS (even though it's fixed in upstream)
# IF this is the case, call it again with *this* script as the wm.
if [ -n "${__IN_VISUAL_SPAWN:-}" ]; then
  cmd=("$wmpath")
elif grep -q 'unset DBUS_SESSION_BUS_ADDRESS' "$(which startx)"; then
  export __IN_VISUAL_SPAWN=1
  cmd=(startx "$0" "$wmpath")
else
  cmd=(startx "$wmpath")
fi

# if server is defined
if [[ "$server" =~ $disp_regex ]]; then
  cmd=("${cmd[@]}" --)
fi
cmd=("${cmd[@]}" "$server" "${rest[@]}")

# from /etc/X11/Xsession.d/20dbus_xdg-runtime
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] &&
  [ "$XDG_RUNTIME_DIR" = "/run/user/$(id -u)" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  # We are under systemd-logind or something remarkably similar, and
  # a user-session socket has already been set up.
  #
  # Be nice to non-libdbus, non-sd-bus implementations by using
  # that as the session bus address in the environment. The check for
  # XDG_RUNTIME_DIR = "/run/user/`id -u`" is because we know that
  # form of the address, from systemd-logind, doesn't need escaping,
  # whereas arbitrary addresses might.
  DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  export DBUS_SESSION_BUS_ADDRESS
fi

printf '%s ' exec "${cmd[@]}" && printf '\n'
# export XDG_SESSION_TYPE=x11
exec "${cmd[@]}"
