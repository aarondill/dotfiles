#!/usr/bin/env bash
set -euC

err() { printf '%s\n' "$@" >&2; }
abort() {
  err "$1"
  exit "${2:-1}"
}

if [ "$#" -gt 0 ]; then
  abort "This script does not accept any arguments" 2
elif [ -z "${DISPLAY:-}" ]; then
  abort "Please run this script in a Xorg session" 2
fi

optional() { "$@" || true; }
revert() {
  optional xset dpms force on
  optional xset dpms 0 0 0
}
trap revert HUP INT TERM EXIT
# every 5 seconds
optional xset +dpms dpms 5 5 5
# force off the first time
optional sleep .5 && optional xset dpms force off &
i3lock -n -f -e -c 000000
revert
