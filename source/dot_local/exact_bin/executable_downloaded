#!/usr/bin/env bash
get_latest() {
  local dir="${1:-.}" num=${2:-1}
  find "$dir" -mindepth 1 -maxdepth 1 -type f -printf "%T@ %p\n" | sort -n | cut -d' ' -f 2- | tail -n "$num"

}
dest="${1:-.}"
latest="$(get_latest ~/Downloads/)"
printf '%s\n' "Copying '$latest' to '$dest'"
# cp -Pp -R is posix for cp --archive
cp -pP -i -- "$latest" "$dest"
