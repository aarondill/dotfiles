#!/usr/bin/env bash

# ~/.local/bin/sync-java
#
# usage: sync-java <dest> <src>
# Sync my ~/code/java/ folder to a usb drive
#

set -euC -o pipefail
shopt -s nullglob globstar # Better globs
deps=(rsync diff)

# Find the current file and it's directory
# Source: https://stackoverflow.com/a/246128
SOURCE="${BASH_SOURCE[0]:-}" DIR=''
while [ -L "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$(builtin cd -P -- "$(command dirname -- "$SOURCE")" &>/dev/null && builtin pwd)" || true
  SOURCE="$(command readlink -- "$SOURCE")" || true
  [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
DIR="$(builtin cd -P -- "$(command dirname -- "$SOURCE")" &>/dev/null && builtin pwd)" || true
DIR="${DIR:-"$PWD"}"
utils="$DIR/script_utils.sh"
[ -f "$utils" ] || utils="$(basename -- "$utils")" || true # If utils is not a file, search for it in "$PATH" instead.
# shellcheck source=./script_utils.sh
. "$utils"             # Note: this may error. I can't use it in a conditional or bashls fails.
[ "$?" -eq 0 ] || exit # set -e means that this line should be irrelevant, but just in case.

for cmd in "${deps[@]}"; do
  if ! has_cmd "$cmd"; then abort "$cmd is required to use this program!" 3; fi
done

# Dest defaults to my personal USB's name
dest="${1:-/media/$USER/AARONDILL}"
src="${2:-${java:-$HOME/code/java}}"

if ! [ -d "$dest" ]; then abort "dest: $dest is not a directory!" 1; fi
if ! [ -d "$src" ]; then abort "src: $src is not a directory!" 1; fi

# note: diff dest src to show what copying *will do*
verbose diff -r -- "$dest" "$src" || confirm "source and destination differ. Do you want to override destination?" || abort 'aborting' 1

exclude=('*.class' 'System Volume Information')
# verbose, archive, recursive, update, progress, delete
rsync_args=(-varuP --delete)
for e in "${exclude[@]}"; do rsync_args+=(--exclude "$e"); done
verbose rsync "${rsync_args[@]}" -- "$java/" "$dest/"

verbose diff -r -- "$dest" "$src" || err "warning: source and destination differ!"
