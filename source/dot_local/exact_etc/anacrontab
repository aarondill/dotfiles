SHELL=/bin/sh
PATH=/sbin:/bin:/usr/sbin:/usr/bin
# Don't look for /usr/sbin/sendmail
MAILTO=""

# hopefully this will run before others - it has lower delay (but they are random)
1 0 mkdir.daily mkdir -p "$HOME/.var/log/anacron/"

# period delay name command
1 5 cron.daily run-parts "$HOME/.local/etc/cron.daily" >>"$HOME/.var/log/anacron/cron.daily.log" 2>&1
7 10 cron.weekly run-parts "$HOME/.local/etc/cron.weekly" >>"$HOME/.var/log/anacron/cron.weekly.log" 2>&1
@monthly 15 cron.monthly run-parts "$HOME/.local/etc/cron.monthly" >>"$HOME/.var/log/anacron/cron.monthly.log" 2>&1
