SHELL=/bin/sh
HOME=/home/aaron
PATH=/sbin:/bin:/usr/sbin:/usr/bin
# Don't look for /usr/sbin/sendmail
MAILTO=""

# These replace cron's entries
1	5	cron.daily	run-parts $HOME/.local/etc/cron.daily
7	10	cron.weekly	run-parts $HOME/.local/etc/cron.weekly
@monthly	15	cron.monthly	run-parts $HOME/.local/etc/cron.monthly

