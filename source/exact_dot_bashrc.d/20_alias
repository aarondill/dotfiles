#!/usr/bin/env bash

# ~/.bashrc.d/20_alias
#
# Sets up aliases for user usage
#

# I'm stupid and can't remember what to type
alias quit='exit'
alias :q='exit'
# Alias sudo to call sudo with *my* $HOME/ENV/PATH
alias sudo="sudo -E env PATH=\"\$PATH\""
# Unrestrict fd by default
alias fd="fd -u"
# Ask before overwriting
alias mv="mv -i"
alias cp="cp -ai"

alias backup="~/.backup/dobackup"
alias lastbackup="/usr/bin/cat ~/.backup/backup-time"
alias browser="sensible-browser"
alias fslite="browser fslite.vercel.app 2>/dev/null"
alias la="ls -A"
alias ll="ls -hl"
alias lla="ls -Ahl"
alias cl='clear'
if command -v google-chrome &>/dev/null; then
  # Alias to remove error messages on opening google-chrome
  # Also allows css detection of dark mode
  chrome='2>/dev/null google-chrome --enable-features=WebUIDarkMode --force-dark-mode'
  # shellcheck disable=SC2139 # They are intended to expand at definition
  {
    alias google-chrome="$chrome"
    alias chrome="$chrome"
  }
  unset chrome
fi
# Show battery information
alias battery='upower -i $(upower -e | grep BAT)'

if command -v 7z &>/dev/null; then
  # alias for 7z zipping files that should be hidden
  alias secret-zip='7z a -r -P -mhe=on'
  alias secret-unzip='7z x'
fi

if command -v has >/dev/null; then
  # Allow usage of `has` with non-defined programs
  alias has='HAS_ALLOW_UNSAFE=y has'
fi

# Replace `cat` with `bat`, if installed
bat=$(which bat 2>/dev/null || which batcat 2>/dev/null)
# shellcheck disable=SC2139 # It's intended to expand at definition
if [ -n "$bat" ]; then
  alias cat="$bat"
  export MANPAGER="sh -c 'col -bx | $bat -l man -p'"

  if ! command -v bat &>/dev/null; then
    alias bat="$bat"
  elif ! command -v batcat &>/dev/null; then
    alias batcat="bat"
  fi

fi
unset bat

# if `z` is installed, initiate it and set `cd` to `z`
if zoxide -V &>/dev/null; then
  eval "$(zoxide init bash)"
  # Reuse cd completion if present (overwritten already), else default to directories
  complete=$(complete -p cd 2>/dev/null || printf '%s ' complete -d cd)
  # remove ' cd' and replace with ' z'. Lack of quotes is intentional!
  ${complete% cd} z
  alias cd='z'
fi

# if `bc` is installed set aliases for it
if command -v bc &>/dev/null; then
  alias bc='bc -l'
  alias calc='bc -l'
fi

# if `pnpm` is installed set alias for pnpx
if command -v pnpm &>/dev/null; then
  alias pnpx='pnpm dlx'
fi

# If tealdeer is installed set alias for tldr
if command -v tldr &>/dev/null; then
  alias tldrf='tldr --list | fzf --preview "tldr {1} --color=always" --preview-window=right,70% | xargs tldr --pager'
fi

# Shorter lazygit
if command -v lazygit &>/dev/null; then
  alias lg='lazygit'
fi

# Shorter git
if command -v git &>/dev/null; then
  alias g='git'
  # Reuse git completion if present (overwritten already), else default to directories
  complete=$(complete -p git 2>/dev/null || printf '%s ' complete -o bashdefault -o default -o nospace -F __git_wrap__git_main git)
  # remove ' git' and replace with ' g'. Lack of quotes is intentional!
  ${complete% git} g
  __load_completion git
fi

IBus="org.freedesktop.IBus.session.GNOME.service"
# If it's enabled in the first place
if systemctl list-unit-files --quiet --all --type=service --user --state=enabled "$IBus" &>/dev/null; then
  # shellcheck disable=SC2139 # I exect it to expand now
  alias restart-ibus="systemctl --user restart '$IBus'"
fi
unset IBus

# I don't know how to control emacs. just open dunnet pls
if command -v emacs &>/dev/null; then
  function dunnet() {
    # Constant
    local save_file="$HOME/.config/emacs/games/dunnet.save"

    local skipload=
    # Allow dunnet --nosave to avoid loading save file
    if [ "$1" = "--nosave" ]; then skipload=1 && shift; fi

    # Output to tty
    printf '%s\n' "Run 'restore $(basename -- "$save_file")' to (re)load" "run 'save $(basename -- "$save_file")' to overwrite save data"
    # no-site go-to-save-location no-init load-dunnet anything-else-passed
    local args=(-Q -chdir "$(dirname "$save_file")" -batch -l dunnet "$@")

    if [ -z "$skipload" ] && [ -f "$save_file" ]; then
      # save file exists, auto restore
      cat <(echo "restore $(basename "$save_file")") - | emacs "${args[@]}"
    else
      # No save file exists, just run it
      emacs "${args[@]}"
    fi
  }
  # Don't you DARE open a window
  alias emacs='emacs -nw'
fi

# Allow nvchad if it's installed
if [ -d "${NVCHAD_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/NvChad"}" ]; then
  alias nvchad='NVIM_APPNAME=NvChad nvim'
else
  function nvchad-install() {
    local DESTINATION="${NVCHAD_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/NvChad"}"
    printf '%s\n' "Creating a treeless clone of the nvchad repository in $DESTINATION"
    git clone --filter=tree:0 "https://github.com/NvChad/NvChad" "$DESTINATION" || {
      local err=$?
      printf 'Something went wrong while cloning the nvchad repository!' >&2
      return "$err"
    }
    alias nvchad='NVIM_APPNAME=NvChad nvim'
    printf '%s\n' 'Please run "nvchad" to complete the installation'
    unset -f nvchad-install
  }
fi
# https://nvchad.com/
