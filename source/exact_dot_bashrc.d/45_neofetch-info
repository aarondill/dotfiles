#!/usr/bin/env bash

# ~/.bashrc.d/45_neofetch_info
#
# Displays neofetch if shlvl = 1
# This should be before backup information
#
if [ "$NONEOFETCH" = "1" ]; then return 0; fi
if [ "$SHLVL" -gt "1" ]; then return 0; fi
# disable echo user-typing
stty -echo 2>/dev/null
if command -v neofetch &>/dev/null; then neofetch; fi
# enable echo user-typing
stty echo 2>/dev/null
