#! /usr/bin/env bash

# ~/.bashrc.d/02_path
#
# Includes changes to the path variable
# May include certain paths necessary for
# programs that install in unusual locations
#

# Add the bin files if not already added from the .profile
if ! [[ "$PATH" == *"$HOME/bin"* ]]; then
  PATH="$HOME/bin${PATH:+:$PATH}"
fi
if ! [[ "$PATH" == *"$HOME/.local/bin"* ]]; then
  PATH="$HOME/.local/bin${PATH:+:$PATH}"
fi

if [ -d /usr/lib/jvm ]; then
  # set JAVA_HOME to latest jvm available
  # use sort -V to sort versions. only available in core-utils-7
  # Remove trailing NULL byte with tr -d to avoid bash warning
  JAVA_HOME="$(find /usr/lib/jvm -maxdepth 1 -type d -print0 | sort -zV | tail -zn1 | tr -d '\0')"
  export JAVA_HOME
# export PATH="$JAVA_HOME/bin${PATH:+:$PATH}"
fi

if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/npm/bin" ]; then
  # allow npm bin
  export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/npm/bin${PATH:+:$PATH}"
fi
# allow pnpm bin
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
if [ -d "$PNPM_HOME" ]; then
  export PATH="$PNPM_HOME${PATH:+:$PATH}"
fi

# include flatpaks in path. (Have org.example.app names)
if [ -d /var/lib/flatpak/exports/bin ]; then
  export PATH="${PATH:+$PATH:}/var/lib/flatpak/exports/bin"
fi

# include go in path
if [ -d /usr/local/go/bin ]; then
  export PATH="${PATH:+$PATH:}/usr/local/go/bin"
  export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"
  if command -v go &>/dev/null; then
    PATH="$PATH:$(go env GOPATH)/bin"
  fi
fi
