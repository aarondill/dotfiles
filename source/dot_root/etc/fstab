# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/nvme0n1p4 during installation
UUID=1a3ca66f-5c7f-4d45-9401-b86ba5e29b0a /               ext4    errors=remount-ro 0       1
# /boot/efi was on /dev/nvme0n1p1 during installation
UUID=6416-06C3  /boot/efi       vfat    umask=0077      0       1
# /home was on /dev/nvme0n1p5 during installation
UUID=f763d1c6-8afd-4a9f-8429-cff15369fda6 /home           ext4    defaults        0       2
# swap was on /dev/nvme0n1p6 during installation
UUID=251a8ad6-5c96-4fbe-b2b0-52ca549f45a8 none            swap    sw              0       0
