# <file system> <dir> <type> <options> <dump> <pass>
# /dev/nvme0n1p5 LABEL=Root\134x20-\134x20Arch
UUID=544c3b89-3345-4e9f-827f-b4ac4fcdee04	/         	ext4      	rw,relatime	0 1

# /dev/nvme0n1p4 LABEL=Home\134x20-\134x20Arch
UUID=a92d29a0-95b7-4d0b-99c8-2b0a04ec9fd1	/home     	ext4      	rw,relatime	0 2

# /dev/nvme0n1p1 LABEL=SYSTEM
UUID=B860-F1BD      	/boot/efi     	vfat      	rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro	0 2

# /dev/nvme0n1p6 LABEL=Swap\134x20-\134x20Arch
UUID=e6c25ba3-1d59-4277-9a2c-fcd6418ac89d	none      	swap      	defaults  	0 0

# NFS Backup mount, local IP 10.0.0.2
pihole:/backup      	/mnt/backup/       	nfs      	nofail,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.mount-timeout=10s,retry=1,x-systemd.idle-timeout=1min,max_connect=2      	0 0
