# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>
# /dev/nvme0n1p9 LABEL=Root\134x20-\134x20Arch
UUID=e5a52ae3-1669-4c49-8563-0aab54a92895	/         	ext4      	rw,relatime	0 1

# /dev/nvme0n1p10 LABEL=Home\134x20-\134x20Arch
UUID=a675e86b-d024-41ee-af4c-e40d937ddf07	/home     	ext4      	rw,relatime	0 2

# /dev/nvme0n1p1 LABEL=SYSTEM
UUID=6416-06C3      	/boot/efi 	vfat      	rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro	0 2

# /dev/nvme0n1p8 LABEL=Swap\134x20-\134x20Arch
UUID=ecf35f94-bf06-4840-bc9a-ef990a253425	none      	swap      	defaults  	0 0

# NFS Backup mount
192.168.1.91:/backup      	/mnt/backup/       	nfs      	nofail,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.mount-timeout=10s,retry=1,x-systemd.idle-timeout=1min      	0 0
